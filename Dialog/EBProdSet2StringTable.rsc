		{ String _name = "EBApothecaryTip";							String _text = "The Apothecary produces Health Items from Roots, Herbs, Wine, Seed Oil, Water, and Glassware. Up to 2 Apothecaries can be employed to produce 3 to 4 Healing Broth, Healing Oil or Herbal Tea. Build Cycle: 60."; }
		
		{ String _name = "EBHerbalist";								String _text = "Herbalist"; }
		{ String _name = "EBHerbalistLwr";							String _text = "herbalist"; }
		{ String _name = "EBHerbalistTip";							String _text = "The Herbalist is used to gather herbs and provide simple health and healing for citizens. Up to 2 Herbalists can be employed to gather 2 to 3 Herbs. Build Cycle: 42."; }
		
		{ String _name = "EBGlassWorks";							String _text = "Glass Works";	}
		{ String _name = "EBGlassWorksLwr";							String _text = "glass works";	}
		{ String _name = "EBGlassWorksTip";							String _text = "The Glass Works produces Glass or Glassware from Sand and Coal. Up to 2 Glassmakers can be employed to produce 7 to 8 Glass or 7 to 8 Glassware from 23 Sand + 3 Coal or 23 sand + 4 Industrial Coal. Build Cycles: 58."; }
		
		{ String _name = "EBWinery";								String _text = "Winery";	}
