		{ String _name = "EBWineryTip";								String _text = "The Winery produces Wine from Grape, Plum, or Cherry. 1 Vintner can be employed to produce 7 to 10 Wine from either 45 Cherry, Grape, or Plum. Build Cycle: 72."; }
		
		{ String _name = "EBOilPress";								String _text = "Oil Press";	}
