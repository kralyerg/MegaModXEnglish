		{ String _name = "EBSVRockQuarryFishTip";						String _text = "The Village Quarry is transformed into a Fish Hatchery. Up to 4 fisherman can be employed to catch 5 to 7 fish. Work: 4/6.0. Build Cycles: 32.";  }
