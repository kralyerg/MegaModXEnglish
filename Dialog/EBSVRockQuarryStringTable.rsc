		{ String _name = "EBSVRockQuarryTip";							String _text = "The Village Rock Quarry is used to mine Stone. Up to 12 Stonecutters can be employed to produce 1 to 2 stone. Work: 10/10.0. Capacity: 6000. Build Cycles: 60. Quarry can be transformed into a Resort Area or a Fish Hatchery.";  }
		
		{ String _name = "SVRockQuarryResortUpgradeTip";				String _text = "Transform the Quarry into a Resort Area."; }
		{ String _name = "SVRockQuarryFishUpgradeTip";					String _text = "Transform the Quarry into a Fish Hatchery."; }
		
		{ String _name = "EBSVRockQuarryResort";						String _text = "Village Resort";	}
		{ String _name = "EBSVRockQuarryResortLwr";						String _text = "village resort";	}
		{ String _name = "EBSVRockQuarryResortTip";						String _text = "The Village Quarry is transformed into a Resort Area with Food Market. Up to 2 Vendors can be employed. Provides Entertainment Happiness. Build Cycles: 32.";  }
		
		{ String _name = "EBSVRockQuarryFish";							String _text = "Village Fish Hatchery";	}
