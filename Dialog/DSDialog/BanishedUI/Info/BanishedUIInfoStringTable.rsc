StringTable Info
{
	Entry _strings
	[
		{
			String _name = "HealthHappiness";
			String _text = "Health & Happiness";
		}
		{
			String _name = "HealthHappinessTitle1";
			String _text = "Health & Happiness";
		}
		{
			String _name = "HealthHappinessTitle2";
			String _text = "- of the diseases and ailments that befall villagers, and of their happiness and depression -";
		}
		{
			String _name = "column1text01";
			String _text = "Health and Happiness in Banished is displayed to the player through the use of icons (see to the right), shown as either an average town statistic, or individually when selecting and viewing a citizens UI.";
		}
		{
			String _name = "column1text02";
			String _text = "In playing Banished, it can sometimes be easy to have a village at full hearts or stars (for Health or Happiness levels respectively).";
		}
		{
			String _name = "column1text03";
			String _text = "But when using DS mods*, citizens will be influenced more often, and by a larger degree in what makes them unhealthy and unhappy. This gives the player a more challenging and interactive game-play experience.";
		}
		{
			String _name = "column1text04";
			String _text = "*(this will only be in effect when certain DS mods are placed above other mods that may also alter the citizen file).";
		}
		{
			String _name = "column1text05";
			String _text = "It now becomes necessary to ensure adequate nutrition, spiritual and other needs are supplied to citizens, along with placing a higher importance in town planning to combat the negative happiness influencers.";
		}
		{
			String _name = "column1text06";
			String _text = "Illness & Diseases";
		}
		{
			String _name = "column1text07";
			String _text = "Along with changes to the health and happiness of the citizens, there are changes";
		}
		{
			String _name = "column1text07add";
			String _text = "to the likelihood and types of diseases that citizens may acquire. When a citizen befalls to any of these they will need the care of a Hospital and Physician/Doctor.";
		}
		{
			String _name = "column1text08";
			String _text = "a list of the illnesses, diseases & ailments:";
		}
		{
			String _name = "column1text09";
			String _text = "Apoplexy (stroke)";
		}
		{
			String _name = "column1text10";
			String _text = "Atrophy (muscle wasting)";
		}
		{
			String _name = "column1text11";
			String _text = "Biliousness";
		}
		{
			String _name = "column1text12";
			String _text = "Black fever (parasitic)";
		}
		{
			String _name = "column1text13";
			String _text = "Blood-poisoning (sepsis)";
		}
		{
			String _name = "column1text14";
			String _text = "Broken bone";
		}
		{
			String _name = "column1text15";
			String _text = "Chicken Pox";
		}
		{
			String _name = "column1text16";
			String _text = "Cholera";
		}
		{
			String _name = "column1text17";
			String _text = "Diarrhea";
		}
		{
			String _name = "column1text18";
			String _text = "Diphtheria";
		}
		{
			String _name = "column1text19";
			String _text = "Dysentery (the bloody flux)";
		}
		{
			String _name = "column1text20";
			String _text = "Endocarditis (water elf disease)";
		}
		{
			String _name = "column1text21";
			String _text = "Ergotism (st. anthony's fire)";
		}
		{
			String _name = "column1text22";
			String _text = "Gonorrhea";
		}
		{
			String _name = "column1text23";
			String _text = "Influenza (sweating sickness)";
		}
		{
			String _name = "column1text24";
			String _text = "Leprosy (lepry)";
		}
		{
			String _name = "column1text25";
			String _text = "Malaria (the ague)";
		}
		{
			String _name = "column1text26";
			String _text = "Measles";
		}
		{
			String _name = "column1text27";
			String _text = "Mumps";
		}
		{
			String _name = "column1text28";
			String _text = "Plague (the black death)";
		}
		{
			String _name = "column1text29";
			String _text = "Pneumonia";
		}
		{
			String _name = "column1text30";
			String _text = "Scarlet fever";
		}
		{
			String _name = "column1text31";
			String _text = "Scrofula (the King's evil)";
		}
		{
			String _name = "column1text32";
			String _text = "Scurvy";
		}
		{
			String _name = "column1text33";
			String _text = "Small Pox (the red plague)";
		}
		{
			String _name = "column1text34";
			String _text = "Tuberculosis";
		}
		{
			String _name = "column1text35";
			String _text = "Typhoid fever (typhus)";
		}
		{
			String _name = "column1text36";
			String _text = "Whooping-Cough";
		}
		{
			String _name = "column1text37";
			String _text = "Yellow fever";
		}
		{
			String _name = "column1labelDeathLow";
			String _text = "likelihood of death: unlikely";
		}
		{
			String _name = "column1labelDeathMed";
			String _text = "likelihood of death: possible";
		}
		{
			String _name = "column1labelDeathHigh";
			String _text = "likelihood of death: common";
		}
		{
			String _name = "column1labelAcqVeryLow";
			String _text = "likelihood of acquiring: very low";
		}
		{
			String _name = "column1labelAcqLow";
			String _text = "likelihood of acquiring: low";
		}
		{
			String _name = "column1labelAcqAvg";
			String _text = "likelihood of acquiring: occasional";
		}
		{
			String _name = "column1labelAcqAbAvg";
			String _text = "likelihood of acquiring: common";
		}
		{
			String _name = "column1labelAcqHigh";
			String _text = "likelihood of acquiring: high";
		}
		{
			String _name = "column1labelAcqVeryHigh";
			String _text = "likelihood of acquiring: very high";
		}
		{
			String _name = "column1labelTransNo";
			String _text = "can be transmitted? no";
		}
		{
			String _name = "column1labelTransYes";
			String _text = "can be transmitted? yes";
		}
		{
			String _name = "column2text01";
			String _text = "Health icons:";
		}
		{
			String _name = "column2text02";
			String _text = "The health of a citizen is determined by many factors:";
		}
		{
			String _name = "column2text03";
			String _text = "Having a complete diet consisting of many foods from all categories: Fruits, Grains. Proteins & Vegetables.";
		}
		{
			String _name = "column2text04";
			String _text = "Herbalists with ample supplies of Herbs & medicine.";
		}
		{
			String _name = "column2text05";
			String _text = "Doctors and an adequate patient treating capacity for the quick prevention of illness and disease.";
		}
		{
			String _name = "column2text06";
			String _text = "Trading boats and Nomads carry a high risk of bringing illness and disease to villages. This can dramatically lower the health of citizens if preventative controls are not in place.";
		}
		{
			String _name = "column2text07";
			String _text = "Likewise, a lack of Herbalists to administer, or an inadequate Herbs and Medicine supply, will mean common illness will be rife amongst the villagers. This becomes worrisome with overly unhealthy citizens who are likely to harbour and transmit deadly diseases.";
		}
		{
			String _name = "column2text08";
			String _text = "It is extremely important to keep your citizens warm as the temperatures drop. This means not only a ready supply of fuels for a household, but adequate paths and roads for citizens to reach places of warmth quickly.";
		}
		{
			String _name = "column2text09";
			String _text = "Buildings that offer health to citizens are distinguished by their radius colours:";
		}
		{
			String _name = "column2text10";
			String _text = "Herbalists, are known for picking, preparing and administering medicinal herbs for the many minor ailments, that befall citizens throughout their lives.";
		}
		{
			String _name = "column2text11";
			String _text = "Hospitals & Doctors, are needed for the treatment of illness & diseases of the infectious and deadly nature, as well as complicated ailments like broken bones (see list to the left).";
		}
		{
			String _name = "column3text01";
			String _text = "Happiness icons:";
		}
		{
			String _name = "column3text02";
			String _text = "The Happiness of a citizen is divided into the following positive categories given by buildings, they are easily discernible by their corresponding radius colours:";
		}
		{
			String _name = "column3text03";
			String _text = "Safety";
		}
		{
			String _name = "column3text04";
			String _text = "Goods";
		}
		{
			String _name = "column3text05";
			String _text = "Spirit";
		}
		{
			String _name = "column3text06";
			String _text = "Entertainment";
		}
		{
			String _name = "column3text07";
			String _text = "Alcohol";
		}
		{
			String _name = "column3text08";
			String _text = "Other";
		}
		{
			String _name = "column3text09";
			String _text = "Further to this there is also a negative aspect sometimes given by noisy, smelly or dangerous buildings:";
		}
		{
			String _name = "column3text10";
			String _text = "Detraction";
		}
		{
			String _name = "column3text11";
			String _text = "Depression becomes very real for unhappy citizens, they will idle more often and become less productive.";
		}
		{
			String _name = "column3text12";
			String _text = "And as in a downward spiral: the less work they achieve, the more unhappy they become.";
		}
		{
			String _name = "column3text13";
			String _text = "Keeping your citizens feel safe by means of Fire-fighting wells, or even guard towers and walls.";
		}
		{
			String _name = "column3text14";
			String _text = "Markets, Merchants & Trading Posts, along with some production buildings can bring Goods happiness to citizens.";
		}
		{
			String _name = "column3text15";
			String _text = "Ensuring their Spiritual needs are fulfilled by Chapels and places of worship and prayer, but also by cemeteries and places where citizens can mourn their lost ones.";
		}
		{
			String _name = "column3text16";
			String _text = "Entertainment happiness is split into two categories, defined by their radius colours:";
		}
		{
			String _name = "column3text17";
			String _text = "Alcohol, Inns & Taverns. Citizens enjoy consuming alcohol and tavern life. Keep the cellars and ale houses full.";
		}
		{
			String _name = "column3text18";
			String _text = "Other Entertainment happiness can come from theatres, monuments or other buildings that are unrelated to alcohol.";
		}
		{
			String _name = "column3text19";
			String _text = "The radius of buildings with a Detraction will negatively influence any citizen within. Through town planning and building positive influencers around these production buildings, you can ensure that workers will not become overly unhappy.";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

StringTable InfoHouseholdFuels
{
	Entry _strings
	[
		{
			String _name = "HouseholdFuels";
			String _text = "Household Fuels";
		}
		{
			String _name = "HouseholdFuelsTitle1";
			String _text = "Household Fuels";
		}
		{
			String _name = "HouseholdFuelsTitle2";
			String _text = "- of the fuels that citizens will use for the heating of their homes -";
		}
		{
			String _name = "column1text01a";
			String _text = "The heating of ones home is as important as the roof and walls that contain the warmth. The hearth of a house is what makes it a home, it's where citizens will keep warm and cook their meals.";
		}
		{
			String _name = "column1text01b";
			String _text = "Depending on the housing, their requirement for fuel is only below a certain temperature. For example the vanilla wood & stone houses will require a fuel to keep the citizens warm at 50degF and below (this represents the quality of the houses insulation, being able to withstand lower temperatures).";
		}
		{
			String _name = "column1text01c";
			String _text = "The variance in the warmth of the vanilla housing comes from the amount of heat and time that will be available from a household fuel (how efficient the hearth/fire is). A wood house will give a warmth rating of 60, whereas the stone house will give a warmth rating of 90, thus achieving more heat from less fuel.";
		}
		{
			String _name = "valueTip";
			String _text = "Value of product";
		}
		{
			String _name = "valueTolTip";
			String _text = "Value of product, this product has a fluctuating value; as such traders may offer or buy at a price within this range";
		}
		{
			String _name = "weightTip";
			String _text = "Weight of product";
		}
		{
			String _name = "quantityTip";
			String _text = "Quantity of product produced by educated-or-uneducated workers";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "is made from:";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "or:";
		}
		{
			String _name = "Firewood00";
			String _text = "Firewood";
		}
		{
			String _name = "Firewood00Tip";
			String _text = "Firewood is produced and stored under the Fuel: Household limit. 6 are made from a Log by both uneducated and educated woodcutters.";
		}
		{
			String _name = "Firewood01";
			String _text = "1 Log";
		}
		{
			String _name = "Firewood01Tip";
			String _text = "There is a per cycle input cost of 5 for the single log. Both Uneducated and Educated workers will make a total profit of 7 or 1.17 per Firewood.";
		}
		{
			String _name = "Firewood02";
			String _text = "2 Timber";
		}
		{
			String _name = "Firewood02Tip";
			String _text = "There is a per cycle input cost of 8 for the timber. Both Uneducated and Educated workers will make a total profit of 4 or 0.67 per Firewood.";
		}
		{
			String _name = "FirewoodQty";
			String _text = "Output: 6";
		}
		{
			String _name = "FirewoodValue";
			String _text = "2";
		}
		{
			String _name = "FirewoodWeight";
			String _text = "2";
		}
		{
			String _name = "column2text09";
			String _text = "Charcoal";
		}
		{
			String _name = "Charcoal00Tip";
			String _text = "Charcoal, created by a thermal reaction called pyrolysis is produced under the limit of Fuels: Metallurgical to control production. Charcoal is also a Fuel that will be used by citizens to heat their homes if available nearby to them.";
		}
		{
			String _name = "column2text10";
			String _text = "21 Logs";
		}
		{
			String _name = "Charcoal01Tip";
			String _text = "This method has a per cycle input cost of 105. Uneducated will give a profit of 133 or 3.91 per piece of Charcoal, meanwhile; an Educated worker will make a total profit of 280 or 5.09 per piece of Charcoal.";
		}
		{
			String _name = "CharcoalQty";
			String _text = "Output: 34-55";
		}
		{
			String _name = "CharcoalValue";
			String _text = "7";
		}
		{
			String _name = "CharcoalWeight";
			String _text = "5";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

