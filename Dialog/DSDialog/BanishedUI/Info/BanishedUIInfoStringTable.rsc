		}
		{
			String _name = "BronzeWeight";
			String _text = "25";
		}
		{
			String _name = "column2text16";
			String _text = "Silver";
		}
		{
			String _name = "Silver00Tip";
			String _text = "Wondrous Silver, commonly used as a currency, being an item of high-value low-weight, it is produced under its own limit to control production/accumulation.";
		}
		{
			String _name = "column2text17";
			String _text = "2 Silver Ore + ";
		}
		{
			String _name = "column2text18";
			String _text = "1 Coke or Charcoal";
		}
		{
			String _name = "Silver01Tip";
			String _text = "This method has a per cycle input cost of 23-24(Charcoal-Coke). Uneducated will make a loss of 2-3 for only 1 piece of Silver will be made, meanwhile; an Educated worker will make a total profit of 18-19 (Coke-Charcoal) or 9-9.5 per piece of Silver.";
		}
		{
			String _name = "SilverQty";
			String _text = "Output: 1-2";
		}
		{
			String _name = "SilverValue";
			String _text = "21";
		}
		{
