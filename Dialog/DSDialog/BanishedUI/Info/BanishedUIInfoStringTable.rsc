			String _text = "Quantity of product produced by educated-or-uneducated workers";
		}
		{
			String _name = "qualityTip";
			String _text = "Tool Quality & useful life, the higher the number; the better the quality and the longer the useful life of the tool.";
		}
		{
			String _name = "CopperTool01";
			String _text = "Copper Tool";
		}
		{
