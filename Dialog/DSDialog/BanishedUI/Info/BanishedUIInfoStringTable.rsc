			String _text = "25";
		}
		{
			String _name = "column2text01cBronze";
			String _text = "Bronze";
		}
		{
			String _name = "Bronze00Tip";
			String _text = "Bronze is produced under the limit of Metals, Alloys & forged to control production. Uses are in tools and building construction.";
		}
		{
			String _name = "column2text02cBronze";
			String _text = "7 Copper Ore + ";
		}
		{
			String _name = "Bronze01Tip";
			String _text = "This method has a per cycle input cost of 47-49(Charcoal-Coke). Uneducated will make a profit of 11-13 for only 1 piece of Bronze will be made, meanwhile; an Educated worker will make a total profit of 41-43 (Coke-Charcoal) or 13.67-14.33 per piece of Bronze.";
		}
		{
			String _name = "column2text04cBronze";
			String _text = "1 Tin Ore + ";
		}
