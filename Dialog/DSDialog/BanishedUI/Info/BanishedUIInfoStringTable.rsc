		}
		{
			String _name = "column2text11";
			String _text = "Lime";
		}
		{
			String _name = "Lime00Tip";
			String _text = "Lime, made from exposing soft stone to heat, uses the limit Raw Materials to control production. Incredibly useful for many different applications.";
		}
		{
			String _name = "column2text12";
			String _text = "1 Stone + ";
		}
		{
			String _name = "column2text13";
			String _text = "1 Coke or Charcoal";
		}
		{
			String _name = "Lime01Tip";
			String _text = "This method has a per cycle input cost of 19-20(Charcoal-Coke). Uneducated will give a profit of 5-6 (Coke-Charcoal) or 1-1.2 per portion of Lime, meanwhile; an Educated worker will make a total profit of 20-21 or 2.5-2.63 per portion of Lime.";
		}
		{
			String _name = "column2text14";
			String _text = "1 Stone + ";
		}
		{
			String _name = "column2text15";
			String _text = "5 Coal or Firewood";
		}
		{
			String _name = "Lime02Tip";
			String _text = "This method has a per cycle input cost of 22-27(Firewood-Coal). Uneducated will give a profit of 3 with Firewood and a loss of 2 from Coal, meanwhile; an Educated worker will make a total profit of 13-18 (Coal-Firewood) or 1.63-2.25 per portion of Lime.";
		}
		{
			String _name = "LimeQty";
			String _text = "Output: 5-8";
		}
		{
			String _name = "LimeValue";
