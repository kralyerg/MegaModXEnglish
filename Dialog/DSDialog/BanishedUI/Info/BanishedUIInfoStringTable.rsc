			String _text = "21";
		}
		{
			String _name = "column2text19";
			String _text = "Silver Ingot";
		}
		{
			String _name = "SilverIngot00Tip";
			String _text = "A skilled craftsmen is able to successfully forge a Silver Ingot, using less fuel for a greater mass of silver, of higher value used as a currency, it is produced under the limit of Silver to control production/accumulation.";
		}
		{
			String _name = "column2text20";
			String _text = "6 Silver Ore + ";
		}
		{
			String _name = "column2text21";
			String _text = "1 Coke or Charcoal";
		}
		{
			String _name = "SilverIngot01Tip";
			String _text = "This method has a per cycle input cost of 55-56(Charcoal-Coke). Uneducated will give a loss of 5-6 as they will not be able to maintain furnace heat with such a small quantity of fuel, and only produce 1 Silver Ingot, meanwhile; an Educated skilled worker will make a total profit of 44-45 (Coke-Charcoal) or 22-22.5 per Silver Ingot.";
		}
		{
			String _name = "SilverIngotQty";
			String _text = "Output: 1-2";
		}
		{
			String _name = "SilverIngotValue";
			String _text = "50";
		}
		{
			String _name = "SilverIngotWeight";
			String _text = "50";
		}
		{
			String _name = "GoldTitle";
			String _text = "Gold";
		}
		{
			String _name = "Gold00Tip";
			String _text = "Gold, though not purposely mined, nor found in large enough quantities to do so, is found in its native pure form and sometimes extracted in silver mines or panned for along rivers and streams. Used as a currency, Gold also has its own limit to control production/accumulation.";
		}
		{
			String _name = "GoldQty";
			String _text = "Output: 1";
		}
		{
			String _name = "Gold01Tip";
			String _text = "Gold is a rare, valuable metal, the likelihood of finding it is low, a 1:21 chance.";
		}
		{
			String _name = "GoldValue";
