			String _text = "Coke";
		}
		{
			String _name = "Coke00Tip";
			String _text = "Coke, a 'cooked' form of coal is produced under the limit of Fuels: Metallurgical to control production.";
		}
		{
			String _name = "column2text08";
			String _text = "21 Coal";
		}
		{
			String _name = "Coke01Tip";
			String _text = "This method has a per cycle input cost of 63. Uneducated will give a profit of 105 or 5 per piece of Coke, meanwhile; an Educated worker will make a total profit of 209 or 6.15 per piece of Coke.";
		}
		{
			String _name = "CokeQty";
