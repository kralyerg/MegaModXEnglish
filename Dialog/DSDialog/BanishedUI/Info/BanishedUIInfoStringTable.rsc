		{
			String _name = "CokeWeight";
			String _text = "3";
		}
		{
			String _name = "column2text09";
			String _text = "Charcoal";
		}
		{
			String _name = "Charcoal00Tip";
			String _text = "Charcoal, created by a thermal reaction called pyrolysis is produced under the limit of Fuels: Metallurgical to control production. Charcoal is also a Fuel that will be used by citizens to heat their homes if available nearby to them.";
		}
		{
			String _name = "column2text10";
			String _text = "21 Logs";
		}
		{
			String _name = "Charcoal01Tip";
			String _text = "This method has a per cycle input cost of 105. Uneducated will give a profit of 133 or 3.91 per piece of Charcoal, meanwhile; an Educated worker will make a total profit of 280 or 5.09 per piece of Charcoal.";
