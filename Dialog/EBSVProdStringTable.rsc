		{ String _name = "EBSVTanneryTip";								String _text = "The Village Tannery produces Cured Leather. 1 Tanner can be employed to produce 1 Cured Leather from 1 Leather, 1 Water, and 3 Salt. Build Cycles: 50. 2 F Key Color Variations.";  }
		
		{ String _name = "EBSVSaltMine";								String _text = "Village Salt Mine";	}
		{ String _name = "EBSVSaltMineLwr";								String _text = "village salt mine";	}
		{ String _name = "EBSVSaltMineTip";								String _text = "The Village Salt Mine extracts Salt from a salt Mine. Up to 2 Workers can be employed to extract and process the Salt. Producing: 8 to 12 Salt. Build Cycles: 52. 2 F Key Color Variations."; }
		
		{ String _name = "EBSVWaterWell";								String _text = "Village Water Well";	}
		{ String _name = "EBSVWaterWellLwr";							String _text = "village water well";	}
		{ String _name = "EBSVWaterWellTip";							String _text = "The Village Water Well contains water. 1 Worker can be employed to gather 12 to 16 Water from the Well. Build Cycles: 42. 2 F Key Color Variations."; }
		
		{ String _name = "EBSVShoemaker";								String _text = "Village Shoemaker";	}
		{ String _name = "EBSVShoemakerLwr";							String _text = "village shoemaker";	}
		{ String _name = "EBSVShoemakerTip";							String _text = "The Village Shoemaker produces Shoes. 1 Cobbler can be employed to produce several kind of shoes from either Leather, Linseed Oil, and Cured Leather.  Build Cycles: 50. 2 F Key Color Variations.";  }
		
		{ String _name = "EBSVOilPress";								String _text = "Village Oil Press";	}
		{ String _name = "EBSVOilPressLwr";								String _text = "village oil press";	}
		{ String _name = "EBSVOilPressTip";								String _text = "The Village Oil Press produces 14 to 18 Vegetable Oil from 25 Kernels and 1 Amphora, 14 to 18 Seed Oil from 25 Pecan, or 25 Walnut and 1 Amphora or 14 to 18 Linseed Oil from 25 Flax and 1 Amphora. Up to 2 Pressers can be employed to produce 18 to 24 Seed Oil from either Pecan or Walnut, produce 18 to 24 Vegetable Oil from 50 Kernels, produce 18 to 24 Linseed Oil from 50 Flax. Build Cycles: 48. 2 F Key Color Variations."; }
		
		{ String _name = "EBSVSandPit";									String _text = "Village Sand Pit"; }
		{ String _name = "EBSVSandPitLwr";								String _text = "village sand pit"; }
		{ String _name = "EBSVSandPitTip";								String _text = "The Village Sand Pit produces Sand. Up to 3 Workers can be employed to produce 5 to 7 Sand. Build Cycles: 36. 2 F Key Color Variations."; }
		
		{ String _name = "EBSVPottery";									String _text = "Village Pottery";	}
		{ String _name = "EBSVPotteryLwr";								String _text = "village Pottery";	}
		{ String _name = "EBSVPotteryTip";								String _text = "The Village Pottery produces Amphoras. 1 Potter can be employed to produce 3 to 4 Amphoras from 4 Clay and either 1 Coal or 1 Charcoal. Build Cycles: 50. 2 F Key Color Variations.";  }
		
		{ String _name = "EBSVKiln";									String _text = "Village Kiln";	}
		{ String _name = "EBSVKilnLwr";									String _text = "village kiln";	}
		{ String _name = "EBSVKilnTip";									String _text = "The Village Kiln produces Bricks. 1 Worker can be employed to produce Bricks from Clay and Fuel.  Build Cycles: 50. 2 F Key Color Variations.";  }
		
		{ String _name = "EBSVClayPit";									String _text = "Village Clay Pit"; }
