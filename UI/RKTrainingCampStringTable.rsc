		{ String _name = "CitationRKTrainingCamp1Tip";			String _text = "You are the bows from which your children as  living arrows are sent forth. - Khalil Gibran."; }
		{ String _name = "CitationRKTrainingCamp2Tip";			String _text = "Every nation has a flag. - Ayman Odeh."; }
		{ String _name = "CitationRKTrainingCamp3Tip";			String _text = "Attack is the secret of defense; defense is    the planning of an attack. - Sun Tzu."; }
		{ String _name = "CitationRKTrainingCamp4Tip";			String _text = "I don't think that architecture is only about shelter, is only about a very simple enclosure. It should be able to excite you , to calm you , to make you think. - Zaha Hadid."; }
		{ String _name = "CitationRKTrainingCamp5Tip";			String _text = "The human race has one really effective weapon, and that is laughter. - Mark Twain."; }
		{ String _name = "CitationRKTrainingCamp6Tip";			String _text = "The most powerful weapon on earth is the human soul on fire. - Ferdinand Foch."; }
		{ String _name = "CitationRKTrainingCamp7Tip";			String _text = "Nonviolence is a powerful and just weapon. - Martin Luther King, Jr."; }
		{ String _name = "CitationRKTrainingCamp8Tip";			String _text = "A well-ordered life is like climbing a tower; the view halfway up is better than the view from the base, it steadily becomes finer as the horizon expands. - William Lyon Phelps."; }
		{ String _name = "CitationRKTrainingCamp9Tip";			String _text = "So I can't show you how, exactly, health care is a basic human right. But what I can argue is that no one should have to die of a disease that is treatable. - Paul Farmer."; }

