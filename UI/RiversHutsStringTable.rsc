		{
			String _name = "NewMedievalFlatToolTip";
			String _text = "Flat Tool serves to flat the ground back to normal after deleting a Canal piece, a Pond or an Open sky Mine... Also very helpful to raze hills too. It will lay orange X on the ground. Once the task is done, you will need to use the Remove Building Tool to get rid of the orange X.";
		}
	]
