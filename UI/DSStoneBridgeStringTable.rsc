		{ String _name = "DSStoneBridgeMenuTip";		String _text = "DS Stone Bridge. a modular bridge, including housing, storage, production & services."; }
		
		{ String _name = "DSNormalStoneBridgeL";		String _text = "Stone Bridge Left"; }
		{ String _name = "DSNormalStoneBridgeLLwr";		String _text = "stone bridge left"; }
		{ String _name = "DSNormalStoneBridgeLTip";		String _text = "left side of normal construction bridge, place from shore to shore. with map orientated to the north, this bridge will be on the left when crossing over in a north-south direction. with an east-west direction, this bridge will be on the top or northern side of bridge. this bridge does not include the end ramps/stairs, you must build these separately. requires 5 work to build per tile"; }
		
		{ String _name = "DSNormalStoneBridgeR";		String _text = "Stone Bridge Right"; }
		{ String _name = "DSNormalStoneBridgeRLwr";		String _text = "stone bridge right"; }
		{ String _name = "DSNormalStoneBridgeRTip";		String _text = "right side of normal construction bridge, place from shore to shore. with map orientated to the north, this bridge will be on the right when crossing over in a north-south direction. with an east-west direction, this bridge will be below or southern side of bridge. this bridge does not include the end ramps/stairs, you must build these separately. requires 5 work to build per tile"; }
		
		
