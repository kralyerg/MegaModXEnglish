StringTable UI
{
	Entry _strings
	[
		{
			String _name = "text1";
			String _text = "Smelting at the bloomery is started by the village Laborers who will clear everything from the area, then deliver the ores, charcoal and clay to the site.";
		}
		{
			String _name = "text2";
			String _text = "After which, a Builder will make the bloomery smelter from the clay. Into the bloomery they will add ore and charcoal in alternating layers. The smelter is ignited early on as the layers are added, the builders will undertake most of the work, piercing a hole letting the unwanted slag escape, and when complete, start to demolish.";
		}
		{
			String _name = "text3";
			String _text = "Once this is finished, a Blacksmith will extract the bloom";
		}
		{
			String _name = "text4";
			String _text = "from the smelter, and work it to create the finished product.";
		}
		{
			String _name = "text5";
			String _text = "A Bloomery Smelter will need to be demolished once the Blacksmith has completed processing the Iron.";
		}
		{
			String _name = "text5copper";
			String _text = "A Bloomery Smelter will need to be demolished once the Blacksmith has completed processing the Copper.";
		}
		{
			String _name = "IronRequire";
			String _text = "Iron - the most common and used of the metals; Iron has its own limit to control production. Used importantly as a material to produce Tools, it is also used in building construction.";
		}
		{
			String _name = "CopperRequire";
			String _text = "Copper - produced under the limit of Metals, Alloys & forged to control production. Uses are mostly in building construction, though it can also be used to make Tools and Copper-ware.";
		}
		{
			String _name = "BronzeRequire";
			String _text = "Bronze - produced under the limit of Metals, Alloys & forged to control production. Used as an early product to make Tools, also used in construction.";
		}
		{
			String _name = "CharcoalDestroy";
			String _text = "Press to demolish and start to clean up the site.";
		}
		{
			String _name = "DestroyRemove";
			String _text = "The bloomery smelter has expired; work has now begun on cleaning up the site. Once this is complete you can remove the old base of the smelter.";
		}
		{
			String _name = "DestroyReclaimTip";
			String _text = "Stop the removal of resource and stop destroying this bloomery smelter.";
		}
		{
			String _name = "DestroyButton";
			String _text = "Remove";
		}
		{
			String _name = "DestroyButtonTip";
			String _text = "Now that you are finally ready to remove and clean up after the bloomery smelter:";
		}
		{
			String _name = "text6";
			String _text = "Whoops! the builders have left behind the base of the spent bloomery smelter, press the button to remove it.";
		}
	]

}
