StringTable resource
{
	Entry _strings
	[
		{
			String _name = "DSForgeWorkshop";
			String _text = "Smith's Hearth";
		}
		{
			String _name = "DSForgeWorkshopLwr";
			String _text = "smiths hearth";
		}
		{
			String _name = "DSForgeWorkshopTip";
			String _text = "A small start of game forge, at which a blacksmith can make copper tools directly from copper ore (+ log & firewood). It can also make other tools and utensils, Wagon Parts, Iron Fittings, Anvils.";
		}
		{
			String _name = "DSAnvilWorkshop";
			String _text = "Anvil Workshop";
		}
		{
			String _name = "DSAnvilWorkshopLwr";
			String _text = "anvil workshop";
		}
		{
			String _name = "DSAnvilWorkshopTip";
			String _text = "a small anvil workshop for the production of Copper, Bronze and Iron Tools, Wagon Parts, Fishing and Hunting Gear. Employs 1 Blacksmith.";
		}
		{
			String _name = "DSGrindstoneWorkshop";
			String _text = "Grindstone";
		}
		{
			String _name = "DSGrindstoneWorkshopLwr";
			String _text = "grindstone";
		}
		{
			String _name = "DSGrindstoneWorkshopTip";
			String _text = "a small add on to a blacksmith and tool making, the grindstone will employ 1 Blacksmith who will take Tools and sharpen them to create (fine) version of themselves, these are longer lasting versions, denoted with an *asterisk after their name.";
		}
		{
			String _name = "EnableGrindstoneWork";
			String _text = "Sharpening tools on the grindstone";
		}
		{
			String _name = "GrindstoneProductTip";
			String _text = "Select a type of tool to sharpen, once sharpened they will be returned to storage and these sharper, higher quality (adds 25 work points to tools) tools will be denoted with an asterisk (*) after their name. Alternatively, if processed with Linseed Oil, the tools will be improved by 50 work points, these will be denoted with an asterisk and circumflex (*^) after their name.";
		}
		{
			String _name = "CopperToolFineRequire";
			String _text = "Copper Tool* (Copper Tool)";
		}
		{
			String _name = "BronzeToolFineRequire";
			String _text = "Bronze Tool* (Bronze Tool)";
		}
		{
			String _name = "ToolFineRequire";
			String _text = "Iron Tool* (Iron Tool)";
		}
		{
			String _name = "SteelToolFineRequire";
			String _text = "Steel Tool* (Steel Tool)";
		}
		{
			String _name = "HardenedToolFineRequire";
			String _text = "Hardened Tool* (Hardened Tool)";
		}
		{
			String _name = "CopperToolFinerRequire";
			String _text = "Copper Tool*^ (Copper Tool, Linseed Oil)";
		}
		{
			String _name = "BronzeToolFinerRequire";
			String _text = "Bronze Tool*^ (Bronze Tool)";
		}
		{
