StringTable UI
{
	Entry _strings
	[
		{
			String _name = "text1";
			String _text = "Charcoal burning is started by the village Laborers; they will clear everything from the area, then deliver the Logs to the site.";
		}
		{
			String _name = "text2";
			String _text = "After which, a Builder will prepare and place the Logs into a large wood stack, cover the whole thing with some soil, and before fully enclosing; they will ignite the pile.";
		}
		{
			String _name = "text3";
			String _text = "Once the charring process is complete, a Char-burner";
		}
		{
			String _name = "text4";
			String _text = "will ensure the pile is extinguished and extract the Charcoal.";
		}
		{
			String _name = "text5";
			String _text = "Charcoal-piles are dangerous, smelly and smoky. They are best suited for out of villages, within forests or away from other buildings.";
		}
		{
			String _name = "CharcoalRequire";
			String _text = "Charcoal - Metallurgical Fuel, but also used in some homes. When used in blacksmithing it is capable of burning at the very high temperatures needed to melt solid metals.";
		}
		{
			String _name = "CharcoalDestroy";
			String _text = "Press to demolish and start to clean up the site.";
		}
		{
			String _name = "DestroyRemove";
			String _text = "The charcoal-pile has expired; work has now begun on cleaning up the site. Once this is complete you can remove the leftover unwanted ash.";
		}
		{
			String _name = "DestroyReclaimTip";
			String _text = "Stop the removal of resource and stop destroying this charcoal-pile.";
		}
		{
			String _name = "DestroyButton";
			String _text = "Remove";
		}
		{
			String _name = "DestroyButtonTip";
			String _text = "Now that you are finally ready to remove and clean up after the charcoal-pile:";
		}
		{
			String _name = "text6";
			String _text = "Whoops! the builders have left behind the spent ash from the charcoal-pile, press the button to remove it.";
		}
	]

}
