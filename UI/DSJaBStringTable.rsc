		{ String _name = "DSJaBJettyHome3x3Tip";			String _text = "A small jetty home for 5 citizens, quality construction with better materials makes a more comfortable home. Heating and warmth is improved. 1100cap. 3x3. Requires 55 work to build. Buildable over water or on ground - make sure the front door is accessible by citizens. Heating: temp for fuel 50 deg, heat from fuel 80."; }
				
		{ String _name = "DSJaBJettyHome4x3";				String _text = "Jetty House"; }
