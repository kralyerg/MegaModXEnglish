	[
		{
			String _name = "DSFields01Crop";
			String _text = "Crop Field";
		}
		{
			String _name = "DSFields01Food";
			String _text = "Food Field";
		}
		{
			String _name = "DSFields01FoodLwr";
			String _text = "food field";
		}
		{
			String _name = "DSFields01FoodTip";
			String _text = "Used to define an area for farmers to grow and harvest Food crops.";
		}
		{
			String _name = "DSFields01Textile";
			String _text = "Textile Field";
		}
		{
			String _name = "DSFields01TextileLwr";
			String _text = "textile field";
		}
		{
			String _name = "DSFields01TextileTip";
			String _text = "Used to define an area for farmers to grow and harvest Textile crops. This is a purpose prepared Textile Field that uses the Textile & Fabric limit.";
		}
		{
			String _name = "AutoPickup";
			String _text = "with Pickup enabled (default) the farmers will pickup what they harvest and take to storage. If disabled, farmers will harvest quicker, but leave the product on the field.";
		}
	]

}

