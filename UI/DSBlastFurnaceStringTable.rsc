			{ String _name = "DSCoalBellPit1UpgradeLwr";		String _text = "coal bell pit mine"; }
			{ String _name = "DSCoalBellPit1UpgradeTip";		String _text = "Upgrade to allow longer lifespan (5,400), and slightly quicker extraction of Coal with the addition of a pulley system to aid the miners (up to 13 miners). The mine requires 89 work to upgrade."; }
		
	
		{ String _name = "DSSmallIronOreMine";			String _text = "Small Iron Ore Mine"; }
