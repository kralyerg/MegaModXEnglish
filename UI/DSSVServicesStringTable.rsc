StringTable resource
{
	Entry _strings
	[ 
		{ String _name = "DSSVWell";				String _text = "Village Well"; }
		{ String _name = "DSSVWellLwr";				String _text = "village well"; }
		{ String _name = "DSSVWellTip";				String _text = "F-key variants, Village Well for firewater supply (1000 units). Requires 80 work to build."; }
		
		{ String _name = "DSSVWell2x2";				String _text = "Large Village Well"; }
		{ String _name = "DSSVWell2x2Lwr";			String _text = "large village well"; }
		{ String _name = "DSSVWell2x2Tip";			String _text = "F-key variants, Large Village Well for firewater supply (2000 units). Requires 144 work to build."; }
		
		
		{ String _name = "DSSVHerbalist";			String _text = "Village Herbalist"; }
		{ String _name = "DSSVHerbalistLwr";		String _text = "village herbalist"; }
		{ String _name = "DSSVHerbalistTip";		String _text = "The Village Herbalist plays an important role in keeping your citizens healthy. They will gather herbs and provide simple health and healing for citizens. Employs 1-2 Herbalists. Requires 34 work to build."; }	
		
		{ String _name = "DSSVHospital";			String _text = "Village Hospital"; }
		{ String _name = "DSSVHospitalLwr";			String _text = "village hospital"; }
		{ String _name = "DSSVHospitalTip";			String _text = "the Village Hospital will provide a place for your sick citizens to visit and be treated by a physician. Build this to get the basic hospital, upon construction the hospital can be upgraded via a button on the building info panel. Requires 144 work."; }
		{ String _name = "HospitalUpgrade1Tip";			String _text = "Upgrade the Village Hospital, a larger 45 patient capacity, employing 1-2 doctors with a added new wing, outside a stone wall & small garden improvement. Requires 55 work."; }
				
		
		{ String _name = "DSSVVillageHall";				String _text = "Village Hall"; }
		{ String _name = "DSSVVillageHallLwr";			String _text = "village hall"; }
		{ String _name = "DSSVVillageHallTip";			String _text = "the Village Hall will give happiness to citizens, as well as record and show village data for the player. You can have a maximum of 3 Village Halls on a map."; }
		
		{ String _name = "DSSVSchool";					String _text = "Small Village School"; }
		{ String _name = "DSSVSchoolLwr";				String _text = "small village school"; }
		{ String _name = "DSSVSchoolTip";				String _text = "Small Village School. Provides education for 20 students, employs 1 Teacher. Requires 55 work to build."; }
		
		{ String _name = "DSSVChapel";					String _text = "Village Chapel"; }
		{ String _name = "DSSVChapelLwr";				String _text = "village chapel"; }
		{ String _name = "DSSVChapelTip";				String _text = "Village Chapel. capacity 50 citizens. Requires 89 work to build."; }
		
		{ String _name = "DSSVChurch";					String _text = "Village Church"; }
		{ String _name = "DSSVChurchLwr";				String _text = "village church"; }
		{ String _name = "DSSVChurchTip";				String _text = "Village Church. capacity 120 citizens. Requires 144 work to build."; }
		
		{ String _name = "DSSVCemeteryMenuTip";		String _text = "Small Village Cemeteries"; }
		
			{ String _name = "DSSVCemetery";				String _text = "Village Cemetery"; }
			{ String _name = "DSSVCemeteryLwr";				String _text = "village cemetery"; }
			{ String _name = "DSSVCemeteryTip";				String _text = "Village Cemetery. min 7x7, max 30x30. Requires 1 Stone + 1 work to build each tile. Tombstones will remain in cemetery for 4-6 years."; }
		
			{ String _name = "DSSVCemeterySmall";			String _text = "Small Village Cemetery"; }
			{ String _name = "DSSVCemeterySmallLwr";		String _text = "small village cemetery"; }
			{ String _name = "DSSVCemeterySmallTip";		String _text = "Small Village Cemetery. min 5x5, max 15x15. Requires 1 Log + 1 work to build each tile. Tombstones will remain in cemetery for 7-9 years."; }
			
			{ String _name = "DSSVCemeteryNOF";				String _text = "Fenceless Village Cemetery"; }
			{ String _name = "DSSVCemeteryNOFLwr";			String _text = "fenceless village cemetery"; }
			{ String _name = "DSSVCemeteryNOFTip";			String _text = "Fenceless Village Cemetery. min 5x5, max 30x30. Requires 1 work to build each tile. Tombstones will remain in cemetery for 6-8 years."; }
		
	]
}

