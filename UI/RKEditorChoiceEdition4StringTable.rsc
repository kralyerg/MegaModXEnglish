		{ String _name = "NMTTradingpostStoneDockLwr";			String _text = "trading post"; }
		{ String _name = "NMTTradingpostStoneDockTip";			String _text = "NMT Stone Docks Trading Post: a workplace used to buy items needed in exchange for resources produced by the town. Size: 7x9. Cost: 64 lumber, 60 Stone, 16 iron. Happiness radius (goods): 20. Capacity 66,000 weight. Employs 1-8 traders. Tips: Must be built on a lake with access to the main river so merchants can arrive. Trading is the only way to acquire crop / orchard�seeds and�livestock."; }

