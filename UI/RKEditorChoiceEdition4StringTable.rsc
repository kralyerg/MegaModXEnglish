// NMT Food Dock Toolbar --------------------------------------------------------------------------------------------

		{ String _name = "NMTFishingDockSet";			String _text = "Fishing Dock"; }
		{ String _name = "NMTFishingDockSetLwr";		String _text = "fishing dock"; }
		{ String _name = "NMTFishingDockSetTip";		String _text = "NMT Docks Fishing Dock: a workplace where fish are caught. Size: 4x7. Cost: 30 logs. Work Circle Radius: 14. Employs 1-3 fishermen. Tips: Overlapping work circles of two fishing docks or placing any structures within a circle decreases fish caught. Please keep the front of this building free for its crates of fish and dont use it as a walking dock."; }

		{ String _name = "NMTFishingStoneDockSet";		String _text = "Fishing Dock"; }
		{ String _name = "NMTFishingStoneDockSetLwr";		String _text = "fishing dock"; }
		{ String _name = "NMTFishingStoneDockSetTip";		String _text = "NMT StoneDocks Fishing Dock: a workplace where fish are caught. Size: 4x7. Cost: 30 logs. Work Circle Radius: 14. Employs 1-3 fishermen. Tips: Overlapping work circles of two fishing docks or placing any structures within a circle decreases fish caught. Please keep the front of this building free for its crates of fish and dont use it as a walking dock."; }

		{ String _name = "NMTWatermillDock";			String _text = "Watermill"; }
		{ String _name = "NMTWatermillDockLwr";			String _text = "watermill"; }
		{ String _name = "NMTWatermillDockTip";			String _text = "NMT Docks Watermill: a workplace where grain is ground into flour. Size: 7x5. Cost: 48 logs, 8 iron. Employs 1-3 millers. Tips: Takes 16 grain (barley, corn, oats, rice, rye, sorghum, or wheat) and makes 24 flour (uneduc.) / 32 flour (educ.). Please keep the front of this building free for its bags of flour and dont use it as a walking dock."; }

		{ String _name = "NMTWatermillStoneDock";		String _text = "Watermill"; }
		{ String _name = "NMTWatermillStoneDockLwr";		String _text = "watermill"; }
		{ String _name = "NMTWatermillStoneDockTip";		String _text = "NMT StoneDocks Watermill: a workplace where grain is ground into flour. Size: 7x5. Cost: 48 Stone, 8 iron. Employs 1-3 millers. Tips: Takes 16 grain (barley, corn, oats, rice, rye, sorghum, or wheat) and makes 24 flour (uneduc.) / 32 flour (educ.). Please keep the front of this building free for its bags of flour and dont use it as a walking dock."; }

		{ String _name = "NMTSeafoodFarm";			String _text = "Seafood Farm"; }
		{ String _name = "NMTSeafoodFarmLwr";			String _text = "seafood farm"; }
		{ String _name = "NMTSeafoodFarmTip";			String _text = "NMT Docks Seafood Farm: a workplace that produces your choice of seafood. Size: 5x7, Cost: 32 logs. Employs 1-3 fishermen. Tips: Choose one item will be produced: crawdads, crabs, shrimp, lobster, oysters, clams, or scallops. Please keep the front of this building free for its crates of food and dont use it as a walking dock."; }

		{ String _name = "NMTSeafoodFarmRNG";			String _text = "Rng Seafood Farm"; }
		{ String _name = "NMTSeafoodFarmRNGLwr";		String _text = "rng seafood farm"; }
		{ String _name = "NMTSeafoodFarmRNGTip";		String _text = "NMT Docks Random Seafood Farm: a workplace that produces your various seafood. Size: 5x7, Cost: 32 logs. Employs 1-3 fishermen. Tips: Produces a random variety of crawdads, crabs, shrimp, lobster, oysters, clams, scallops and an occasional pearl. Please keep the front of this building free for its crates of food and dont use it as a walking dock."; }

		{ String _name = "NMTRiceFarm";				String _text = "Rice Farm"; }
		{ String _name = "NMTRiceFarmLwr";			String _text = "rice farm"; }
		{ String _name = "NMTRiceFarmTip";			String _text = "NMT Docks Rice Farm: a workplace where rice can be grown in your Docks zone. Size: 6x7. Cost: 36 logs. Employs 1-3 Farmers. Tips: Does not require seeds. Please keep the front of this building free for its bags of food and dont use it as a walking dock."; }

		{ String _name = "NMTCranberryFarm";			String _text = "Cranberry Bog"; }
		{ String _name = "NMTCranberryFarmLwr";			String _text = "cranberry bog"; }
		{ String _name = "NMTCranberryFarmTip";			String _text = "NMT Docks Cranberry Bog: a workplace where cranberries can be grown in your Docks zone. Size: 6x7. Cost: 36 logs. Employs 1-3 Farmers. Tips: Does not require seeds. Please keep the front of this building free for its bags of food and dont use it as a walking dock."; }

		{ String _name = "NMTWatercressFarm";			String _text = "Watercress Farm"; }
		{ String _name = "NMTWatercressFarmLwr";		String _text = "watercress farm"; }
		{ String _name = "NMTWatercressFarmTip";		String _text = "NMT Docks Watercress Farm: a workplace where watercress can be grown in your Docks zone. Size: 6x7. Cost: 36 logs. Employs 1-3 Farmers. Tips: Does not require seeds. Please keep the front of this building free for its bags of food and dont use it as a walking dock."; }


