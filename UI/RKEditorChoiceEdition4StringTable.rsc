// NMT Resources Dock Toolbar --------------------------------------------------------------------------------------------

		{ String _name = "NMTBlacksmithDock";			String _text = "Blacksmith"; }
		{ String _name = "NMTBlacksmithDockLwr";		String _text = "blacksmith"; }
		{ String _name = "NMTBlacksmithDockTip";		String _text = "NMT Docks Blacksmith: a workplace where various tools can be made and ores converted into metals. Size: 7x5. Cost: 65 logs, 8 stone, 12 iron. Employs 1 blacksmith. Tips: Makes the following types of tools: wooden (2 logs), stone (1 log, 1 stone), copper (1 log, 1 copper), iron (1 log, 1 iron), copper alloy (1 log, 1 iron, 1 copper), steel (1 log, 1 iron, 1 coal) or (1 log, 1 iron, 3 charcoal), carbon steel (1 log, 2 iron, 2 coal) or (1 log, 2 iron, 5 charcoal) . Also converts 3 iron ore into 1 iron and 3 copper ore into 1 copper."; }

		{ String _name = "NMTBlacksmith2Dock";			String _text = "Blacksmith"; }
		{ String _name = "NMTBlacksmith2DockLwr";		String _text = "blacksmith"; }
		{ String _name = "NMTBlacksmith2DockTip";		String _text = "NMT Docks Blacksmith: a workplace where various tools can be made and ores converted into metals. Size: 7x5. Cost: 65 logs, 8 stone, 12 iron. Employs 1 blacksmith. Tips: Makes the following types of tools: wooden (2 logs), stone (1 log, 1 stone), copper (1 log, 1 copper), iron (1 log, 1 iron), copper alloy (1 log, 1 iron, 1 copper), steel (1 log, 1 iron, 1 coal) or (1 log, 1 iron, 3 charcoal), carbon steel (1 log, 2 iron, 2 coal) or (1 log, 2 iron, 5 charcoal) . Also converts 3 iron ore into 1 iron and 3 copper ore into 1 copper."; }

		{ String _name = "NMTBlacksmithStoneDock";		String _text = "Blacksmith"; }
		{ String _name = "NMTBlacksmithStoneDockLwr";		String _text = "blacksmith"; }
		{ String _name = "NMTBlacksmithStoneDockTip";		String _text = "NMT Stone Docks Blacksmith: a workplace where various tools can be made and ores converted into metals. Size: 7x5. Cost: 8 logs, 65 stone, 12 iron. Employs 1 blacksmith. Tips: Makes the following types of tools: wooden (2 logs), stone (1 log, 1 stone), copper (1 log, 1 copper), iron (1 log, 1 iron), copper alloy (1 log, 1 iron, 1 copper), steel (1 log, 1 iron, 1 coal) or (1 log, 1 iron, 3 charcoal), carbon steel (1 log, 2 iron, 2 coal) or (1 log, 2 iron, 5 charcoal) . Also converts 3 iron ore into 1 iron and 3 copper ore into 1 copper."; }

		{ String _name = "NMTWoodcutterDock";			String _text = "Woodcutter"; }
		{ String _name = "NMTWoodcutterDockLwr";		String _text = "woodcutter"; }
		{ String _name = "NMTWoodcutterDockTip";		String _text = "NMT Docks Woodcutter: a workplace where firewood is made. Size: 4x5. Cost: 32 logs. Employs 1-2 woodcutters. Tips: Requires 2 logs or 5 lumber or 5 fodder-thatch. Will create 5-8 firewood per job done."; }

		{ String _name = "NMTWoodcutterStoneDock";		String _text = "Woodcutter"; }
		{ String _name = "NMTWoodcutterStoneDockLwr";		String _text = "woodcutter"; }
		{ String _name = "NMTWoodcutterStoneDockTip";		String _text = "NMT Stone Docks Woodcutter: a workplace where firewood is made. Size: 4x5. Cost: 32 Stone. Employs 1-2 woodcutters. Tips: Requires 2 logs or 5 lumber or 5 fodder-thatch. Will create 5-8 firewood per job done."; }

		{ String _name = "NMTSawmillDock";			String _text = "Sawmill"; }
		{ String _name = "NMTSawmillDockLwr";			String _text = "sawmill"; }
		{ String _name = "NMTSawmillDockTip";			String _text = "NMT Docks Sawmill: a workplace where lumber or firewood is made from logs.  Size: 7x5. Cost: 48 logs, 12 iron. Employs 1-3 woodcutters. Tips: Requires 1 log for lumber and 2 for firewood. Will create 3-4 lumber or 5-8 firewood per job done."; }

		{ String _name = "NMTSawmillStoneDock";			String _text = "Sawmill"; }
		{ String _name = "NMTSawmillStoneDockLwr";		String _text = "sawmill"; }
		{ String _name = "NMTSawmillStoneDockTip";		String _text = "NMT Stone Docks Sawmill: a workplace where lumber or firewood is made from logs.  Size: 7x5. Cost: 48 Stone, 12 iron. Employs 1-3 woodcutters. Tips: Requires 1 log for lumber and 2 for firewood. Will create 3-4 lumber or 5-8 firewood per job done."; }

		{ String _name = "NMTTailorDock";			String _text = "Tailor"; }
		{ String _name = "NMTTailorDockLwr";			String _text = "tailor"; }
		{ String _name = "NMTTailorDockTip";			String _text = "NMT Docks Tailor: a workplace where various types of clothes is made. Size: 7x5. Cost: 54 logs, 2 iron. Employs 1 tailor. Tips: Resources required: hide coat (2 leather or 1 leather + 1 cloth/linen, or 2 cloth, or 2 linen), wool coat (2 wool, or 1 wool + 1 cloth/linen) or warm coat (2 leather + 2 wool/cloth/linen, or 2 wool + 2 cloth/linen, or 2 fur). Educated workers create 2 clothing; uneducated only makes 1 clothing. 3-4 cloth or linen will be created from 12 cotton or 12 flax."; }

		{ String _name = "NMTTailorStoneDock";			String _text = "Tailor"; }
		{ String _name = "NMTTailorStoneDockLwr";		String _text = "tailor"; }
		{ String _name = "NMTTailorStoneDockTip";		String _text = "NMT Docks Stone Tailor: a workplace where various types of clothes is made. Size: 7x5. Cost: 54 Stone, 2 iron. Employs 1 tailor. Tips: Resources required: hide coat (2 leather or 1 leather + 1 cloth/linen, or 2 cloth, or 2 linen), wool coat (2 wool, or 1 wool + 1 cloth/linen) or warm coat (2 leather + 2 wool/cloth/linen, or 2 wool + 2 cloth/linen, or 2 fur). Educated workers create 2 clothing; uneducated only makes 1 clothing. 3-4 cloth or linen will be created from 12 cotton or 12 flax."; }

		{ String _name = "NMTTavernDock";			String _text = "Tavern"; }
		{ String _name = "NMTTavernDockLwr";			String _text = "tavern"; }
		{ String _name = "NMTTavernDockTip";			String _text = "NMT Docks Tavern: a workplace where beer, ale or wine is made, stored and consumed; increases the happiness of citizens living nearby. Size: 7x7. Cost: 72 logs, 8 iron, 12 glass. Happiness radius (entertainment): 30. Employs 1-3 brewers. Tips: Resources required: beer (10 malt), strong beer (10 malt, 2 hops), ale (60 blueberry or 30 apple, apricot, cherry, peach, pear, or pumpkin), wine (30 blackberry, grape, plum, raspberry, mulberry, strawberry, watermelon, or mango) or mead (45 honey). It will create 6-10 ale/beers/wine."; }

		{ String _name = "NMTTavernStoneDock";			String _text = "Tavern"; }
		{ String _name = "NMTTavernStoneDockLwr";		String _text = "tavern"; }
		{ String _name = "NMTTavernStoneDockTip";		String _text = "NMT Stone Docks Tavern: a workplace where beer, ale or wine is made, stored and consumed; increases the happiness of citizens living nearby. Size: 7x7. Cost: 72 Stone, 8 iron, 12 glass. Happiness radius (entertainment): 36. Employs 1-3 brewers. Tips: Resources required: beer (10 malt), strong beer (10 malt, 2 hops), ale (60 blueberry or 30 apple, apricot, cherry, peach, pear, or pumpkin), wine (30 blackberry, grape, plum, raspberry, mulberry, strawberry, watermelon, or mango) or mead (45 honey). It will create 6-10 ale/beers/wine."; }

		{ String _name = "NMTDriftersDock";			String _text = "Drifters Dock"; }
		{ String _name = "NMTDriftersDockLwr";			String _text = "drifters dock"; }
		{ String _name = "NMTDriftersDockTip";			String _text = "NMT Drifters Dock: a workplace which job is take a boat and search for unused floating trunks of trees. Size: 7x7. Cost: 48 logs, 8 iron. Can Create: 2-3 logs per job. Employs 1-3 foresters. Tips: You wont see them navigating with their boats, but thats their RPG job: wandering around and get floating logs. The Output numbers are based on a real forester lodge."; }

		{ String _name = "NMTDriftersStoneDock";			String _text = "Drifters Dock"; }
		{ String _name = "NMTDriftersStoneDockLwr";			String _text = "drifters dock"; }
		{ String _name = "NMTDriftersStoneDockTip";			String _text = "NMT Drifters Stone Dock: a workplace which job is take a boat and search for unused floating trunks of trees. Size: 7x7. Cost: 48 logs, 8 iron. Can Create: 2-3 logs per job done. Employs 1-3 foresters. Tips: You wont see them navigating with their boats, but thats their RPG job: wandering around and get floating logs. The Output numbers are based on a real forester lodge."; }

		{ String _name = "NMTWaterMineDock";			String _text = "WaterMine Dock"; }
		{ String _name = "NMTWaterMineDockLwr";			String _text = "waterMine dock"; }
		{ String _name = "NMTWaterMineDockTip";			String _text = "NMT WaterMine Dock: a workplace which job is to take breath and dive and go mine at bottom of the sea floor. Size: 10x10. Cost: 92 logs, 12 iron. Can Create randomly : 2-3 ores or stones per job done. Employs 1-8 miners. Tips: Part of their RPG job is diving to the bottom of the sea floor and mine. Get precious iron ore, copper ore, stone, silver and gold ores, and possibility of gems randomly."; }

