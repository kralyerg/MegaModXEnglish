		{ String _name = "NMTWalkingDock1x3LOWLwr";		String _text = "walking dock"; }
		{ String _name = "NMTWalkingDock1x3LOWTip";		String _text = "Walking Docks (1x3): use to create walkways through a dock zone. Buildings connect to Walking Docks. Size: 1x3. Cost: 12 logs."; }

		{ String _name = "NMTWalkingDock1x1corner";		String _text = "Dock Corner"; }
		{ String _name = "NMTWalkingDock1x1cornerLwr";		String _text = "dock corner"; }
		{ String _name = "NMTWalkingDock1x1cornerTip";		String _text = "Dock Corners: use to prevent your citizens from falling into the water when they turn a corner while using the Walking Docks. Size: 1x1. Cost: 4 logs."; }

		{ String _name = "NMTLowBoatBridge";			String _text = "Boat Bridge"; }
