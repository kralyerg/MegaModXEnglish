		{ String _name = "NMTDock1x1GhStorageTip";			String _text = "NMT Docks Ghost Storage: an open area where a small amount of items stored in a barn can be stored. Size 1x1. Cost: 0. Capacity: 300 weight. Tips: Can be placed anywhere, such as on top of walking docks; citizens can walk through it. Stores: food, tools, clothes, health, textiles, crafted, forged, fabrics, precious, and miscellaneous."; }

		{ String _name = "NMTTradingpostDock";				String _text = "Trading Post"; }
		{ String _name = "NMTTradingpostDockLwr";			String _text = "trading post"; }
		{ String _name = "NMTTradingpostDockTip";			String _text = "NMT Docks Trading Post: a workplace used to buy items needed in exchange for resources produced by the town. Size: 7x9. Cost: 64 lumber, 60 logs, 16 iron. Happiness radius (goods): 20. Capacity 60,000 weight. Employs 1-8 traders. Tips: Must be built on a lake with access to the main river so merchants can arrive. Trading is the only way to acquire crop / orchard�seeds and�livestock."; }

