		{ String _name = "NMTWalkingDock1x1";			String _text = "Coastal Dock"; }
		{ String _name = "NMTWalkingDock1x1Lwr";		String _text = "coastal dock"; }
		{ String _name = "NMTWalkingDock1x1Tip";		String _text = "Coastal Dock: use on the shore to connect to the Dock Stairs (which connects to Walking Docks). Size: 1x1. Cost: 4 logs."; }

		{ String _name = "NMTWalkingDock1x1Stairs";		String _text = "Dock Stairs"; }
		{ String _name = "NMTWalkingDock1x1StairsLwr";		String _text = "dock stairs"; }
		{ String _name = "NMTWalkingDock1x1StairsTip";		String _text = "Dock Stairs: use to connect from a Coastal Dock to the lower Dock Streets. Size: 1x1. Cost: 5 logs."; }

		{ String _name = "NMTWalkingDock1x1LOW";		String _text = "Walking Dock"; }
		{ String _name = "NMTWalkingDock1x1LOWLwr";		String _text = "walking dock"; }
		{ String _name = "NMTWalkingDock1x1LOWTip";		String _text = "Walking Docks (1x1): use to create walkways through a dock zone. Buildings connect to Walking Docks. Size: 1x1. Cost: 4 logs."; }

		{ String _name = "NMTWalkingDock1x2LOW";		String _text = "Walking Dock"; }
