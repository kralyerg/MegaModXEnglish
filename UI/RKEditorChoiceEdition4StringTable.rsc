		{ String _name = "NMTSchoolDock";			String _text = "School"; }
		{ String _name = "NMTSchoolDockLwr";			String _text = "school"; }
		{ String _name = "NMTSchoolDockTip";			String _text = "NMT Docks School: educates children starting at age 10 so they produce more when they become adults. Size: 5x7. Cost: 48 logs. Capacity: 24 students. Employs 1 teacher. Tips: If the teacher dies and there are no laborers to take their place, all students will become uneducated laborers."; }

