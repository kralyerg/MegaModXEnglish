		}
		{
			String _name = "DSVillageApiaryProduceTip";
			String _text = "the Village Apiary, beekeepers tend to the bees and harvest either Honey, Comb Honey or Beeswax. Employs 1-2 Beekeepers. Construction requires 89 work to build.";
