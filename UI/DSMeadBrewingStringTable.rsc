StringTable resource
{
	Entry _strings
	[
		{
			String _name = "DSVillageSquareMeadBrewer";
			String _text = "Village Square Mead Brewer";
		}
		{
			String _name = "DSVillageSquareMeadBrewerLwr";
			String _text = "village square mead brewer";
		}
		{
			String _name = "DSVillageSquareMeadBrewerTip";
			String _text = "the Village Square Mead Brewer, a small building to brew and serve Mead and Mulled Mead. Mead is made from either: Honey & Water or Wild Honey & Water. Mulled Mead uses Mead & Herbs. Employs 1 Brewer. The Mead Brewer can store a combined total of 250 weight. Construction requires 55 work to build.";
		}
		{
			String _name = "DSVillageMeadery";
			String _text = "Village Meadery";
		}
		{
			String _name = "DSVillageMeaderyLwr";
			String _text = "village meadery";
		}
		{
			String _name = "DSVillageMeaderyTip";
			String _text = "the Village Meadery, a tavern that brews and serves Mead and Mulled Mead to citizens. Mead is made from either: Honey & Water or Wild Honey & Water. Mulled Mead uses Mead & Herbs. Employs 1-4 Brewers. The meadery can store a combined total of 600 weight. Construction requires 144 work to build.";
		}
		{
			String _name = "MeadWaterRequire";
			String _text = "Mead (40 Honey + 20 Water)";
		}
		{
			String _name = "MeadWildHoneyWaterRequire";
			String _text = "Mead (40 Wild Honey + 20 Water)";
		}
		{
			String _name = "MulledMeadRequire";
			String _text = "Mulled Mead (1 Mead + 1 Herb)";
		}
		{
			String _name = "DSVillageStorageShed2x2";
			String _text = "Village Storage Shed - 2x2";
		}
		{
			String _name = "DSVillageStorageShed2x2Lwr";
			String _text = "village storage shed";
		}
		{
			String _name = "DSVillageStorageShed2x2Tip";
			String _text = "2x2 Village Storage Shed is a simple lean-to storage place for all Foods, Herbs & Medicine, Tools, Clothing, and Crafted Goods & Utensils. Total storage capacity of 900 weight. Construction requires 21 work to build.";
		}
		{
			String _name = "DSVillageStorageShed2x3";
			String _text = "Village Storage Shed - 2x3";
		}
		{
			String _name = "DSVillageStorageShed2x3Lwr";
			String _text = "village storage shed";
		}
		{
			String _name = "DSVillageStorageShed2x3Tip";
			String _text = "2x3 Village Storage Shed is a simple lean-to storage place for all Foods, Herbs & Medicine, Tools, Clothing, and Crafted Goods & Utensils. Total storage capacity of 1250 weight. Construction requires 29 work to build.";
		}
		{
			String _name = "DSVillageBeehiveTrunks";
			String _text = "Village Beehives";
		}
		{
			String _name = "DSVillageBeehiveTrunksLwr";
			String _text = "village beehives";
		}
		{
			String _name = "DSVillageBeehiveTrunksTip";
			String _text = "at the Village Beehives, a beekeeper will tend to the bees and randomly harvest Honey, Beeswax & Comb Honey. Employs 1 Beekeeper. Construction requires 34 work to build.";
		}
		{
			String _name = "DSVillageApiary";
			String _text = "Village Apiary";
		}
		{
			String _name = "DSVillageApiaryLwr";
			String _text = "village apiary";
		}
		{
			String _name = "DSVillageApiaryTip";
			String _text = "the Village Apiary, beekeepers tend to the bees and randomly harvest Honey, Beeswax, Comb Honey & Royal Jelly. Employs 1-2 Beekeepers. Construction requires 89 work to build.";
		}
		{
			String _name = "DSVillageApiaryProduce";
			String _text = "Village Apiary";
		}
