StringTable startConditions
{
	Entry _strings
	[
		{
			String _name = "Easy0Name";
			String _text = "Industry: Tools";
		}
		{
			String _name = "Easy0Desc";
			String _text = "An easy game, begins with five families and homes. A large amount of clothing, food, firewood, charcoal, tools, logs, iron and stone are provided. The Thadd Surrel storage barns have already been built, as well as the Thadd Surrel Blacksmith, and the Smith's Hearth and Grindstone. Some seeds for fields and orchards are available as well as a herd of livestock.";
		}
		{
			String _name = "Easy2Name";
			String _text = "Industry: Flax, Linen & Lamp Oil";
		}
		{
			String _name = "Easy2Desc";
			String _text = "An easy game, begins with five families and homes. A large amount of clothing, food, firewood, charcoal, tools, logs, iron and stone are provided. The Thadd Surrel storage barns have already been built, as well as the Thadd Surrel Flax Weaver, Oil Kiln, and Press Shed. Flax seeds for the field and an orchard seed are available as well as a herd of livestock.";
		}
		{
			String _name = "Medium0Name";
			String _text = "Industry: Thadd Surrel storage";
		}
