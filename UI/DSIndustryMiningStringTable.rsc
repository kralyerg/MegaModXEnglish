		}
		{
			String _name = "DSThaddSurrelFlaxFarmerPlanterTip";
			String _text = "Thadd Surrel & family Flax Farm Planter, requires Linseed to construct, 1-3 farmers will plant and grow Flax. Requires 34 work to build.";
		}
		{
			String _name = "DSThaddSurrelFlaxFarmerHarvester";
