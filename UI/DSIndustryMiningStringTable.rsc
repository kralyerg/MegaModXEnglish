			String _text = "coke oven";
		}
		{
			String _name = "DSCokeOven1Tip";
			String _text = "Use the oven to 'cook' Coal, removing impurities allowing a hotter, stronger heat in the form of Coke. Requires 55 work to build. F-key variants.";
		}
		{
			String _name = "DSCokeOven1Lime";
