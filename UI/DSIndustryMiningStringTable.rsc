		}
		{
			String _name = "DSWorkersConstructionYard";
			String _text = "Worker's Construction Yard";
		}
		{
			String _name = "DSWorkersConstructionYardLwr";
			String _text = "workers construction yard";
		}
		{
			String _name = "DSWorkersConstructionYardTip";
			String _text = "Ideal for early game to produce many of the needed construction items to help your village expand. Produce either Timber, Iron Fittings, Bricks, Roof-tiles, Lime or Glass. Ensure you have a supply of the required Logs, Iron, Charcoal, Stone, Clay, Sand. Requires 34 work to build. Only 2 can be built on a map.";
		}
		{
			String _name = "DSBlacksmith01";
			String _text = "Blacksmith";
		}
		{
			String _name = "DSBlacksmith01Lwr";
			String _text = "blacksmith";
		}
		{
			String _name = "DSBlacksmith01Tip";
			String _text = "This Blacksmith can produce Tools, Iron Fittings, Anvils and Wagon Parts. A metallurgical fuel will be required to operate. Requires 89 work to build.";
		}
		{
			String _name = "DSThaddSurrelBlacksmith";
			String _text = "Thadd Surrel & family: Blacksmith";
		}
		{
			String _name = "DSThaddSurrelBlacksmithLwr";
			String _text = "industry blacksmith";
		}
		{
			String _name = "DSThaddSurrelBlacksmithTip";
			String _text = "The Thadd Surrel & family Blacksmith, produces Tools, Iron Fittings, Anvils and Wagon Parts. A metallurgical fuel will be required to operate. Requires 89 work to build.";
		}
		{
			String _name = "DSThaddSurrelTinsmith";
			String _text = "Thadd Surrel & family: Tinsmith";
		}
		{
			String _name = "DSThaddSurrelTinsmithLwr";
			String _text = "industry tinsmith";
		}
		{
			String _name = "DSThaddSurrelTinsmithTip";
			String _text = "The Thadd Surrel & family Tinsmith, produces Tinware. Requires 89 work to build.";
		}
		{
			String _name = "DSIndustryWoodChopper";
			String _text = "Wood Chopper";
		}
		{
			String _name = "DSIndustryWoodChopperLwr";
			String _text = "wood chopper";
		}
		{
			String _name = "DSIndustryWoodChopperTip";
			String _text = "1 woodcutter is employed to cut logs or timber into Firewood. Requires 8 work to build.";
		}
		{
			String _name = "DSThaddSurrelLumbermill";
			String _text = "Thadd Surrel & family: Timber-mill";
		}
		{
			String _name = "DSThaddSurrelLumbermillLwr";
			String _text = "industry timbermill";
		}
		{
			String _name = "DSThaddSurrelLumbermillTip";
			String _text = "The Thadd Surrel & family Timber-mill, 1-5 woodcutters will operate the mill, processing Logs into Timber or Firewood. Requires 144 work to build.";
		}
		{
			String _name = "DSWaterPowerFurnace";
			String _text = "Water-powered Blast Furnace";
		}
		{
			String _name = "DSWaterPowerFurnaceLwr";
			String _text = "blast furnace";
		}
		{
			String _name = "DSWaterPowerFurnaceTip";
			String _text = "Requiring construction next to a stream or river, using high temperatures and a large air flow, this blast furnace is the perfect addition to an industrial settlement. Water-power is used to operate large bellows, forcing air into the furnace. It is capable of processing high quantities of Iron Ore into Iron, Copper Ore into Copper, Tin Ore into Tin or Copper and Tin Ores into Bronze with the aid of a metallurgical fuel (coke or charcoal). Employs 1-8 blacksmiths. Building construction requires 233 work.";
		}
		{
			String _name = "DSBlastFurnace";
			String _text = "Thadd Surrel & family: Blast Furnace";
		}
		{
			String _name = "DSBlastFurnaceLwr";
			String _text = "blast furnace";
		}
		{
			String _name = "DSBlastFurnaceTip";
			String _text = "Able to be built on flat ground, this blast furnace is able to get to the high temperatures by the inclusion of a copper boiler steam engine to operate the bellows. This furnace is the perfect addition to an industrial settlement. It is capable of processing high quantities of Iron Ore into Iron, Copper Ore into Copper, Tin Ore into Tin or Copper and Tin Ores into Bronze with the aid of a metallurgical fuel (coke or charcoal). Employs 1-6 blacksmiths. Building construction requires 233 work. F-key variants.";
		}
		{
			String _name = "DSHillLimeKiln";
			String _text = "Hill Lime Kiln";
		}
		{
			String _name = "DSHillLimeKilnLwr";
			String _text = "hill lime kiln";
		}
		{
			String _name = "DSHillLimeKilnTip";
			String _text = "The Hill Lime Kiln will take Stone and produce Lime (also known as quicklime). Lime can be used in the process to make Iron, and is also used as construction material (mortar & render). Requires 89 work to build. Must be built up against a hill or mountain.";
		}
		{
			String _name = "DSSilverFineryFurnace";
			String _text = "Silver Finery Furnace";
		}
		{
			String _name = "DSSilverFineryFurnaceLwr";
			String _text = "silver finery furnace";
		}
		{
			String _name = "DSSilverFineryFurnaceTip";
			String _text = "The Silver Finery Furnace is used to process Silver Ore into Silver. A metallurgical fuel will be required to operate. Employs 1 blacksmith. Requires 89 work to build.";
		}
		{
			String _name = "DSThaddSurrelCoinTradingPost";
			String _text = "Thadd Surrel & family: Trade Merchant, purchase office";
		}
		{
			String _name = "DSThaddSurrelCoinTradingPostLwr";
			String _text = "industry trade merchant";
		}
		{
			String _name = "DSThaddSurrelCoinTradingPostTip";
			String _text = "The purchase office will allow you to trade for all goods with coins, gold & silver. Regular visits from seven different merchants supplying all resources, one offering seeds. Though no pasture animals can be purchased here. The Merchant requires 144 work to build.";
		}
		{
			String _name = "DSThaddSurrelTradingPost";
			String _text = "Thadd Surrel & family: Trade Merchant, goods buyer";
		}
		{
			String _name = "DSThaddSurrelTradingPostLwr";
			String _text = "industry trade merchant";
		}
		{
			String _name = "DSThaddSurrelTradingPostTip";
			String _text = "The goods buyer will see regular visits from a Trader's Guild Merchant, they will purchase all resources from you with payment of coins, gold & silver. The Merchant requires 233 work to build.";
		}
		{
			String _name = "EnableTradeWork";
