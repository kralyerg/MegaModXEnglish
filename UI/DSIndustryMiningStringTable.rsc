		}
		{
			String _name = "DSThaddSurrelFlaxFarmerHarvesterTip";
			String _text = "Thadd Surrel & family Flax Farm Harvester, 1-3 farmers will harvest Flax. Requires 21 work to build.";
		}
		{
			String _name = "DSThaddSurrelPressShed";
			String _text = "Thadd Surrel & family: Press Shed";
		}
		{
			String _name = "DSThaddSurrelPressShedLwr";
			String _text = "press shed";
		}
		{
			String _name = "DSThaddSurrelPressShedTip";
			String _text = "Thadd Surrel & family Press Shed, where a worker will produce either Lamp Oil or an edible Seed Oil from almonds, chestnuts, hazelnuts, pecans or walnuts. Requires 34 work to build.";
		}
		{
			String _name = "DSCoalBellPit1";
			String _text = "Coal Bell Pit";
		}
		{
			String _name = "DSCoalBellPit1Lwr";
			String _text = "coal bell pit";
		}
		{
			String _name = "DSCoalBellPit1Tip";
			String _text = "A primitive Coal mine, built on flat ground, requires 3-8 miners who will extract only Coal from a 'bell' shaped pit in the ground. It has a limited production of 600 and will need to be upgraded once depleted to continue operation. Requires 34 work to build.";
		}
		{
			String _name = "DSCoalBellPit1Upgrade";
			String _text = "Coal Bell Pit Mine";
		}
		{
			String _name = "DSCoalBellPit1UpgradeLwr";
			String _text = "coal bell pit mine";
		}
		{
			String _name = "DSCoalBellPit1UpgradeTip";
			String _text = "Upgrade the bell pit to allow a further production of 5,400, and a slightly quicker extraction of Coal with the addition of a pulley system to aid the miners (up to 13 miners). Requires 89 work to upgrade.";
		}
		{
			String _name = "DSSmallIronOreMine";
			String _text = "Small Iron Ore Mine";
		}
		{
			String _name = "DSSmallIronOreMineLwr";
			String _text = "small iron ore mine";
		}
		{
			String _name = "DSSmallIronOreMineTip";
			String _text = "A small mountain mine that employs 1-13 miners who will extract Iron Ore only. It has a limited production of 1,200, but can be upgraded to continue operation. Requires 21 work to construct the mine entrance. A cheap mine, but to get maximum production the mine must be placed in an ideal location *the mine may be difficult to place, persevere.";
		}
		{
			String _name = "DSSmallIronOreMineUpgradeOilLamps";
			String _text = "Iron Ore Mine";
		}
		{
			String _name = "DSSmallIronOreMineUpgradeOilLampsLwr";
			String _text = "iron ore mine";
		}
		{
			String _name = "DSSmallIronOreMineUpgradeOilLampsTip";
			String _text = "Upgrade to allow a longer lifespan of 24,800, and slightly quicker extraction of Iron Ore with up to 21 miners able to be employed. Requires 89 work to upgrade";
		}
		{
			String _name = "ImprovedMine";
			String _text = "Improved Mine";
		}
		{
			String _name = "ImprovedMineLwr";
			String _text = "improved mine";
		}
		{
			String _name = "ImprovedMineTip";
			String _text = "The Improved Mine model, made in collaboration with Yandersen. This is a mountain mine that employs 1-30 miners who will extract either: Iron Ore, Copper Ore, or Coal. It has a limited production of 21,000. Requires 144 work to build.";
		}
		{
			String _name = "DSThaddSurrelMineOilLamps";
			String _text = "Thadd Surrel & family: Industry Mine";
		}
		{
			String _name = "DSThaddSurrelMineOilLampsLwr";
			String _text = "industry mine";
		}
		{
			String _name = "DSThaddSurrelMineOilLampsTip";
			String _text = "The industrial, Thadd Surrel & family Mine. Capable of extracting Iron Ore, Copper Ore, Tin Ore or Coal, requires Timber & either Lamp Oil or Candles to operate. Employs 1-55 miners. The mine has a large production of 250,000 over the course of its life. Requires 233 work to build.";
		}
		{
			String _name = "DSIndustryMineSecond";
			String _text = "Thadd Surrel & family: 2nd Industry Mine";
		}
		{
			String _name = "DSIndustryMineSecondLwr";
			String _text = "second industry mine";
		}
		{
			String _name = "DSIndustryMineSecondTip";
			String _text = "The large, second industrial, Thadd Surrel & family Mine. Capable of extracting Iron Ore, Copper Ore, Tin Ore or Coal, requires Timber & either Lamp Oil or Candles to operate. Employs 1-72 miners. The mine has an almost lifetime production of 5,000,000 over the course of its life. Requires 512 work to build.";
		}
		{
			String _name = "DSClarenceSilverMine01";
			String _text = "Clarence Silver Mine, 1st star";
		}
		{
			String _name = "DSClarenceSilverMine01Lwr";
			String _text = "clarence silver mine";
		}
		{
			String _name = "DSClarenceSilverMine01Tip";
			String _text = "The Clarence Silver Mine, a large Silver Ore mine, first build at 1st star level, the mine employs 1-8 miners, and will require Timber & 2 Lamp Oil to operate. The mine has a limited production before needing to be upgraded to continue mining silver ore. Requires 89 work to build.";
		}
		{
			String _name = "DSClarenceSilverMine02";
			String _text = "Clarence Silver Mine, 2nd star";
		}
		{
			String _name = "DSClarenceSilverMine02Lwr";
			String _text = "clarence silver mine";
		}
		{
			String _name = "DSClarenceSilverMine02Tip";
			String _text = "Upgrade the mine, extending the rear sorting room to make way for a larger mine opening. The existing tunnels will be reinforced to cope with a slightly larger mine workforce of 13. The upgraded mine will have a total output of 610 before further upgrade is required. Requires 144 work to build.";
		}
		{
			String _name = "DSClarenceSilverMine03";
			String _text = "Clarence Silver Mine, 3rd star";
		}
		{
			String _name = "DSClarenceSilverMine03Lwr";
			String _text = "clarence silver mine";
		}
		{
			String _name = "DSClarenceSilverMine03Tip";
			String _text = "By upgrading the mine, you will be adding a large overhead pulley system, which will allow a deeper mine, and a faster extraction with the pulleys making carting the heavy ores to the surface easier. The mine can hire up to 21 miners. The upgraded mine will have a total output of 1,597 before further upgrade is required. Requires 233 work to build.";
		}
		{
			String _name = "DSClarenceSilverMine04";
			String _text = "Clarence Silver Mine, 4th star";
		}
		{
			String _name = "DSClarenceSilverMine04Lwr";
			String _text = "clarence silver mine";
		}
		{
			String _name = "DSClarenceSilverMine04Tip";
			String _text = "Upgrade and further enhance the pulley system by adding another pulley! quicker extraction again, and now the mine can employ up to 34 miners. But that isn't all, the mines lighting is getting upgraded, production return is increased with miners now only requiring 1 Lamp Oil. The upgraded mine will have a total output of 4,181 before further upgrade is required. Requires 377 work to build.";
		}
		{
			String _name = "DSClarenceSilverMine05";
			String _text = "Clarence Silver Mine, 5th star";
		}
		{
			String _name = "DSClarenceSilverMine05Lwr";
			String _text = "clarence silver mine";
		}
		{
			String _name = "DSClarenceSilverMine05Tip";
			String _text = "By upgrading the mine, the installation of railway tracks will allow the use of quicker carts, increasing the production rate. This is the final depth of the mine, after which it will be depleted of all Silver Ore. It has a total capacity of 10,946. Requires 610 work to build.";
		}
		{
			String _name = "UpgradeClarenceSilverMine01Txt";
			String _text = "upgrade the mine once depleted:";
		}
		{
			String _name = "DSPlacerMine01";
			String _text = "Placer Mine";
		}
		{
			String _name = "DSPlacerMine01Lwr";
			String _text = "placer mine";
		}
		{
			String _name = "DSPlacerMine01Tip";
			String _text = "A placer mine will extract Tin Ore and Gold from an embankment of a waterway. Employs 1-4 miners. The mine has a long lifetime production of 13,000 over the course of its life. Requires 84 work to build.";
		}
		{
			String _name = "DSIndustrialQuarry";
			String _text = "Industrial Quarry";
		}
		{
			String _name = "DSIndustrialQuarryLwr";
			String _text = "industrial quarry";
		}
		{
			String _name = "DSIndustrialQuarryTip";
			String _text = "An industrial sized quarry for the extraction and processing of Stone. Production requires Tools for Stonemasons (Tools:Stonemason) to operate which can be made at a blacksmith. Employs 1-34 stonecutters. The quarry has a large production of 200,000 over the course of its life. Requires 144 work to build.";
		}
		{
			String _name = "DSCokeOvenMenuTip";
			String _text = "Battery Coke & Lime Ovens . Modular build, processes Coal into Coke or Stone into Lime.";
		}
