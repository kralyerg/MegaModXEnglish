		}
		{
			String _name = "DSCokeOven1LimeTip";
			String _text = "The Lime Oven will take Stone and produce Lime (also known as quicklime). Lime can be used in the process to make Iron, and is also used as building material (mortar & render). Requires 55 work to build.";
		}
		{
