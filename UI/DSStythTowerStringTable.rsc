	Entry _strings
	[ 
		{ String _name = "DSStythTowerMenuTip";			String _text = "Styth Towers - Watchtowers for your town. When staffed, they will generate a random selection of goods from confiscating stolen items from what we might only assume are bandits? or aliens...."; }
	
		{ String _name = "DSStythTower";					String _text = "Styth Tower"; }
		{ String _name = "DSStythTowerLwr";					String _text = "styth tower"; }
		{ String _name = "DSStythTowerTip";					String _text = "Styth Tower, the original Styth watchtower that generates a small random number of items for the town (Alcohol,Tools,Clothing,Food,Etc) by ridding the area of bandits, the town receives the spoils. employs 1-2 Village Guards. You can only build 1 Styth Tower on a map."; }
		
		{ String _name = "DSNewStythTower";					String _text = "New Styth Tower"; }
		{ String _name = "DSNewStythTowerLwr";				String _text = "new styth tower"; }
		{ String _name = "DSNewStythTowerTip";				String _text = "New Styth Tower, a new update Styth Tower, slightly larger in size, this watchtower generates a better number of random items for the town (Alcohol,Tools,Clothing,Food,Precious,Etc) by ridding the area of bandits, the town receives the spoils. employs 2-3 Village Guards. You can only build 1 New Styth Tower on a map."; }
		
		{ String _name = "ProfessionVillageGuard";			String _text = "Village Guard"; }
		{ String _name = "ProfessionVillageGuardTip";		String _text = "A Village Guard is employed to serve and protect the town. They are employed at Watchtowers. It is accepted that their mortality rate is higher than other professions."; }
		{ String _name = "ProfessionVillageGuardDeath";		String _text = "died from severe wounds, after protecting the town from bandits."; }
		
		
