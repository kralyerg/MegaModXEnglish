StringTable resource
{
	Entry _strings
	[ 


	// #########################################
	// ##          Starting Settings          ##
	// #########################################

		{ String _name = "CCAdamEve";			String _text = "[CC] Adam & Eve"; }
		{ String _name = "CCAdamEveDesc";		String _text = "Start with just 2 people. A small amount of food, firewood and clothing is provided in a small storage cart. No structures have been built, no seeds or livestock are initially available - you will have to survive and acquire everything."; }
		
		{ String _name = "CCMissionary";		String _text = "[CC] Missionary"; }
		{ String _name = "CCMissionaryDesc";		String _text = "A Missionary game begins with a Parish House and three families, 2 of them are uneducated. 2 houses are already built and some basic supplies are provided. A storage cart is available. Some seeds for fields and orchards are available as well as a herd of livestock."; }
		
		{ String _name = "CCFort";			String _text = "[CC] New Frontier"; }
		{ String _name = "CCFortDesc";			String _text = "The New Frontier starts you off at a frontier outpost next to a friendly native American village. Defend and nurture your citizens and your legend will be told in the west for all time. This game starts with 3 families and a small fort with some supplies has already been constructed. Includes the option to discover treasures at a ceremonial ground."; }

		{ String _name = "CCFortHard";			String _text = "[CC] Native Village - Hard"; }
		{ String _name = "CCFortHardDesc";		String _text = "The Native Village start requires you to have good relations with the native tribe in the area and is a fairly hard start. The village will require resources (upgrades) to signal your friendship and then you'll have a choice of how you want to interact with the buildings. As foreigners in this land you have much to learn and gain from seeking allies instead of enemies."; }

		{ String _name = "CCFortAE";			String _text = "[CC] Native Village - Adam and Eve"; }
		{ String _name = "CCFortAEDesc";		String _text = "Start with just 2 people. A small amount of food, firewood and clothing is provided in a small storage cart. The Native Village start requires you to have good relations with the native tribe in the area and is a fairly hard start. The village will require resources (upgrades) to signal your friendship and then you'll have a choice of how you want to interact with the buildings. As foreigners in this land you have much to learn and gain from seeking allies instead of enemies."; }

		{ String _name = "LlamaEasyName";		String _text = "[CC] Curse of the Golden Llama - Easy"; }
		{ String _name = "LlamaEasyDesc";		String _text = "The Curse of the Golden Llama is the closest thing to a mystery in the world of banished. What is the Golden Llama? What mysteries does it hold? Dare you explore its murky interior? This is a game that starts according to regular Easy settings, but includes the option to adventure for the chance at treasure. "; }

		{ String _name = "LlamaMediumName";		String _text = "[CC] Curse of the Golden Llama - Medium"; }
		{ String _name = "LlamaMediumDesc";		String _text = "The Curse of the Golden Llama is the closest thing to a mystery in the world of banished. What is the Golden Llama? What mysteries does it hold? Dare you explore its murky interior? This is a game that starts according to regular Medium settings, but includes the option to adventure for the chance at treasure."; }

		{ String _name = "LlamaHardName";		String _text = "[CC] Curse of the Golden Llama - Hard"; }
		{ String _name = "LlamaHardDesc";		String _text = "The Curse of the Golden Llama is the closest thing to a mystery in the world of banished. What is the Golden Llama? What mysteries does it hold? Dare you explore its murky interior? This is a game that starts according to regular Hard settings, but includes the option to adventure for the chance at treasure. "; }

		{ String _name = "LlamaAEName";			String _text = "[CC] Curse of the Golden Llama - Adam & Eve"; }
		{ String _name = "LlamaAEDesc";			String _text = "The Curse of the Golden Llama is the closest thing to a mystery in the world of banished. What is the Golden Llama? What mysteries does it hold? Dare you explore its murky interior? This is a game that starts according to Adam and Eve settings, but includes the option to adventure for the chance at treasure. "; }


	// ######################################################
	// ##    Toolbars, Sub-toolbars and toolbar entries    ##
	// ######################################################

		{ String _name = "ThemeItemsTip"; 				String _text = "Themed Sets"; }
		{ String _name = "PalisadeItemsTip";				String _text = "Build Palisade Walls."; }
		{ String _name = "FortItemsTip";				String _text = "Fort and Palisade Structures."; }
		{ String _name = "NativeItemsTip"; 				String _text = "Native Items"; }

		{ String _name = "FlattenCC";					String _text = "Flatten Terrain"; }
		{ String _name = "FlattenCCTip";				String _text = "Flattens the terrain. Water and holes come up, mountains come down. Use the remove structures tool to delete yellow icons after the terrain has been flattened. Use this tool very carefully as you cannot undo your actions."; }

		{ String _name = "PlankBridge";					String _text = "Creek Plank Bridge"; }
		{ String _name = "PlankBridgeLwr";				String _text = "creek plank bridge"; }
		{ String _name = "PlankBridgeTip";				String _text = "A small creek bridge made of wood. This bridge is designed for the small creeks, not the large rivers, but will work with both."; }

		{ String _name = "RockBridge";					String _text = "Rock Bridge"; }
		{ String _name = "RockBridgeLwr";				String _text = "Rock bridge"; }
		{ String _name = "RockBridgeTip";				String _text = "A small rock bridge made of stones. This bridge is designed for the small creeks, not the large rivers, but will work with both."; }



	// #########################################
	// ##    Native buildings    ##
	// #########################################
		{ String _name = "NCeremony";				String _text = "Ceremonial Ground"; }
		{ String _name = "NCeremonyLwr";			String _text = "ceremonial ground"; }
		{ String _name = "NCeremonyTip";			String _text = "A small ground appearing to be of some historical significance."; }
		
		{ String _name = "TeePee";				String _text = "Native Teepee"; }
		{ String _name = "TeePeeLwr";				String _text = "native teepee"; }
		{ String _name = "TeePeeTip";				String _text = "A small native tent, traditionally made of animal skins upon wooden poles."; }
		{ String _name = "TeePeeHouseUpgradeTip";		String _text = "Convert to a residence. Barter peacefully with the natives and they will gift you this building (it will also allow this building to be removed if desired)."; }
		{ String _name = "TeePeeStorageUpgradeTip";		String _text = "Convert to a storage building. Barter peacefully with the natives and they will gift you this building (it will also allow this building to be removed if desired)."; }

		{ String _name = "TeePeeHouse";				String _text = "Native Teepee Residence"; }
		{ String _name = "TeePeeHouseLwr";			String _text = "native teepee residence"; }
		{ String _name = "TeePeeHouseTip";			String _text = "A small native tent, traditionally made of animal skins upon wooden poles. Family of 4."; }

		{ String _name = "LongHouse";				String _text = "Native Longhouse"; }
		{ String _name = "LongHouseLwr";			String _text = "native longhouse"; }
		{ String _name = "LongHouseTip";			String _text = "A large native longhouse, traditionally made of wood, bark or thatch or a combination of the three."; }
		{ String _name = "LongHouseHouseUpgradeTip";		String _text = "Convert to a boarding house. Barter peacefully with the natives and they will gift you this building (it will also allow this building to be removed if desired)."; }
		{ String _name = "LongHouseStorageUpgradeTip";		String _text = "Convert to a storage building. Barter peacefully with the natives and they will gift you this building (it will also allow this building to be removed if desired)."; }

		{ String _name = "LongHouseStorage";			String _text = "Native Longhouse Storage"; }
		{ String _name = "LongHouseStorageLwr";			String _text = "native longhouse storage"; }
		{ String _name = "LongHouseStorageTip";			String _text = "A large native longhouse, traditionally made of wood, bark or thatch or a combination of the three. 4,000 Weight Capacity."; }
		
		{ String _name = "WigWam";				String _text = "Native WigWam"; }
		{ String _name = "WigWamLwr";				String _text = "native wigwam"; }
		{ String _name = "WigWamTip";				String _text = "A domed, round native structure made from wood poles, bark and thatch."; }
		{ String _name = "WigWamHouseUpgradeTip";		String _text = "Convert to a residence. Barter peacefully with the natives and they will gift you this building (it will also allow this building to be removed if desired)."; }
		{ String _name = "WigWamStorageUpgradeTip";		String _text = "Convert to a storage building. Barter peacefully with the natives and they will gift you this building (it will also allow this building to be removed if desired)."; }

		{ String _name = "WigWamHouse";				String _text = "Native WigWam House"; }
		{ String _name = "WigWamHouseLwr";			String _text = "native wigwam house"; }
		{ String _name = "WigWamHouseTip";			String _text = "A domed, round native structure made from wood poles, bark and thatch. Family of 5."; }
		
		{ String _name = "Totem";					String _text = "Totem Pole"; }
		{ String _name = "TotemLwr";					String _text = "totem pole"; }
		{ String _name = "TotemTip";					String _text = "Totem poles are monumental sculptures carved on poles, posts, or pillars with symbols or figures made from large trees."; }
		{ String _name = "Totem1";					String _text = "Figures on the pole seem to be symbolic reminders for the native people..."; }

		{ String _name = "TribalHut";					String _text = "Native Hut"; }
		{ String _name = "TribalHutLwr";				String _text = "Native Hut"; }
		{ String _name = "TribalHutTip";				String _text = "A small native home. Family of 5."; }
		
		{ String _name = "TribalTent";					String _text = "Native Tent"; }
		{ String _name = "TribalTentLwr";				String _text = "native Tent"; }
		{ String _name = "TribalTentTip";				String _text = "A small native tent, traditionally made of animal skins upon wooden poles. Family of 4."; }

		{ String _name = "Canoe";					String _text = "Canoe"; }
		{ String _name = "CanoeLwr";					String _text = "Canoe"; }
		{ String _name = "CanoeTip";					String _text = "Decorative native Canoe."; }




		{ String _name = "MilMagazine";				String _text = "Magazine"; }
		{ String _name = "MilMagazineLwr";			String _text = "magazine"; }
		{ String _name = "MilMagazineTip";			String _text = "A large walled storage building. Able to store huge quantities of resources. 60,000 Weight Capacity."; }
		
		{ String _name = "Forwardpost";				String _text = "Forward Post"; }
		{ String _name = "ForwardpostLwr";			String _text = "forward post"; }
		{ String _name = "ForwardpostTip";			String _text = "This post represents one of your military force's forays into enemy territory. Successful warfare in this era requires guns and proud colourful uniforms, but as you vanquish your enemies the post will generate many useful items for your colony - including various lucrative building supplies, valuable artefacts, or rare trade goods captured from the defeated."; }
		{ String _name = "ForwardpostBoxTip";			String _text = "Requires: Military Supply.  Produces: Random assortment of Wine, Spirits, Musket, Cannon, Pottery, Gemstones, Hide Coat Native Artefact."; }

		{ String _name = "MusketRange";				String _text = "Musket Range"; }
		{ String _name = "MusketRangeLwr";			String _text = "musket range"; }
		{ String _name = "MusketRangeTip";			String _text = "This is where the soldiers of your colony train to be the very best and most ready for whatever this world throws at them. During the necessary drilling, resources vital to your colony's survival (such as tools and clothes) will be produced."; }
		{ String _name = "MusketRangeBoxTip";			String _text = "Requires: Pfennig. Produces: Random assortment of Steel Tool, Musket, Uniform, Ale, Pipe Tobacco."; }

	// Log cabin
		{ String _name = "Logcabin";				String _text = "Log Cabin"; }
		{ String _name = "LogcabinLwr";				String _text = "log cabin"; }
		{ String _name = "LogcabinTip";				String _text = "Provides housing for a single family. Better warmth and comfort than a wooden home. Family of 5."; }	
		{ String _name = "LogcabinUpgradeTip";			String _text = "Upgrade to a Large Log Cabin. Provides even more warmth and larger inventory space. Family of 7. Some resources from the existing building will be reclaimed."; }

		{ String _name = "Logcabin2";				String _text = "Large Log Cabin"; }
		{ String _name = "Logcabin2Lwr";			String _text = "large log cabin"; }
		{ String _name = "Logcabin2Tip";			String _text = "Provides housing for a single family. Better warmth and comfort than a wooden home. Family of 7."; }
		
		{ String _name = "MilBarracks";				String _text = "Barracks"; }
		{ String _name = "MilBarracksLwr";			String _text = "barracks"; }
		{ String _name = "MilBarracksTip";			String _text = "Barracks Boarding House. 6 Families."; }

		{ String _name = "FieldMedic";				String _text = "Field Medic"; }
		{ String _name = "FieldMedicLwr";			String _text = "Field Medic"; }
		{ String _name = "FieldMedicTip";			String _text = "A small battlefield hospital. 5 Capacity."; }
		
		{ String _name = "LittleChapel";			String _text = "Parish House"; }
		{ String _name = "LittleChapelLwr";			String _text = "parish house"; }
		{ String _name = "LittleChapelTip";			String _text = "A place of worship for small communities. 80 Capacity."; }
		

		{ String _name = "Workcamp";				String _text = "Work Camp"; }
		{ String _name = "WorkcampLwr";				String _text = "work camp"; }
		{ String _name = "WorkcampTip";				String _text = "The military is not just about warfare - construction and development of the landscape have always been a responsibility of the military forces in peacetime. This work camp converts basic pay, tools, and the energy of a restless garrison into basic resources."; }
		{ String _name = "WorkcampBoxTip";			String _text = "Requires: Pfennig and Iron Tools.  Produces: Random assortment of Firewood, Stone, Iron, Coal."; }
		
		{ String _name = "Stitcher";				String _text = "Uniform Maker"; }
		{ String _name = "StitcherLwr";				String _text = "uniform maker"; }
		{ String _name = "StitcherTip";				String _text = "The Uniform Maker is a military specialist concentrating on the production of proud military uniforms. These uniforms are essential to the morale of soldiers in battle and are an important component of your military strength. Makes Uniforms only."; }
		
		{ String _name = "Quartermaster";			String _text = "Quartermaster"; }
		{ String _name = "QuartermasterLwr";			String _text = "quartermaster"; }
		{ String _name = "QuartermasterTip";			String _text = "The Quartermaster is the first and most important piece you must construct when establishing a military presence in a new area. When staffed, Military Supplies will be brought in a steady stream by agents of your Navy."; }
		
		{ String _name = "NativeTrader";				String _text = "Native Trader"; }
		{ String _name = "NativeTraderLwr";				String _text = "native trader"; }
		{ String _name = "NativeTraderTip";				String _text = "A Native Trader will trade an assortment of items with the native population."; }
		
		{ String _name = "Blockhouse";					String _text = "Blockhouse"; }
		{ String _name = "BlockhouseLwr";				String _text = "blockhouse"; }
		{ String _name = "BlockhouseTip";				String _text = "This blockhouse represents a vital strategic point garrisoned with militia. With appropriate supplies it should generate a small income of guilders and pfennig as you tax passers-by, and levy tariffs on merchants."; }
		{ String _name = "BlockhouseBoxTip";				String _text = "Requires: Military Supply.  Produces: Random assortment of Silver Pfennig and Gold Guilder."; }

		{ String _name = "StarFort1";					String _text = "Star Fort"; }
